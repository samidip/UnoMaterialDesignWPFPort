<Page x:Class="UnoMaterialDesign.Presentation.ListsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:ut="using:Uno.Themes"
      xmlns:local="using:UnoMaterialDesign.Presentation"
      Background="{ThemeResource SurfaceBrush}">

  <ScrollViewer>
    <StackPanel Padding="32" Spacing="32" MaxWidth="960"
                HorizontalAlignment="Stretch">

      <!-- Page Header -->
      <TextBlock x:Uid="ListsPage.Title"
                 Text="Lists"
                 Style="{StaticResource HeadlineLarge}" />
      <TextBlock x:Uid="ListsPage.Subtitle"
                 Text="ListView, ItemsRepeater, and data-templated list controls."
                 Style="{StaticResource BodyLarge}"
                 Foreground="{ThemeResource OnSurfaceVariantBrush}" />

      <!-- ═══════ Section 1: Simple ListView ═══════ -->
      <TextBlock Text="Simple ListView"
                 Style="{StaticResource TitleLarge}" />

      <Border Background="{ThemeResource SurfaceVariantBrush}"
              CornerRadius="16" Padding="24"
              Translation="0,0,16">
        <Border.Shadow>
          <ThemeShadow />
        </Border.Shadow>

        <Grid ColumnSpacing="24">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <!-- Plain ListView -->
          <StackPanel Grid.Column="0" Spacing="12">
            <TextBlock Text="Plain items" Style="{StaticResource LabelLarge}" />
            <ListView ItemsSource="{Binding SimpleItems}"
                      IsEnabled="{Binding ListEnabled}"
                      SelectedItem="{Binding SelectedSimpleItem, Mode=TwoWay}"
                      MaxHeight="220"
                      AutomationProperties.Name="Simple list" />
          </StackPanel>

          <!-- Inline items -->
          <StackPanel Grid.Column="1" Spacing="12">
            <TextBlock Text="Inline items" Style="{StaticResource LabelLarge}" />
            <ListView MaxHeight="220"
                      IsEnabled="{Binding ListEnabled}"
                      AutomationProperties.Name="Inline list">
              <ListViewItem Content="Hello" />
              <ListViewItem Content="World" />
              <ListViewItem Content="From Uno" />
              <ListViewItem Content=":)" />
            </ListView>
          </StackPanel>
        </Grid>
      </Border>

      <!-- ═══════ Section 2: Templated Lists ═══════ -->
      <TextBlock Text="Templated Lists"
                 Style="{StaticResource TitleLarge}" />

      <Border Background="{ThemeResource SurfaceVariantBrush}"
              CornerRadius="16" Padding="24"
              Translation="0,0,16">
        <Border.Shadow>
          <ThemeShadow />
        </Border.Shadow>

        <Grid ColumnSpacing="24">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <!-- Project items with avatar -->
          <StackPanel Grid.Column="0" Spacing="12">
            <TextBlock Text="Rich item template" Style="{StaticResource LabelLarge}" />
            <ListView ItemsSource="{Binding ProjectItems}"
                      SelectedItem="{Binding SelectedProject, Mode=TwoWay}"
                      MaxHeight="300"
                      AutomationProperties.Name="Project list">
              <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:ProjectItem">
                  <Grid ColumnSpacing="12" Padding="4,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Avatar circle -->
                    <Border Grid.Column="0"
                            Width="40" Height="40"
                            CornerRadius="20"
                            Background="{ThemeResource PrimaryBrush}"
                            VerticalAlignment="Center">
                      <TextBlock Text="{Binding Code}"
                                 Style="{StaticResource TitleSmall}"
                                 Foreground="{ThemeResource OnPrimaryBrush}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center" />
                    </Border>

                    <!-- Text content -->
                    <StackPanel Grid.Column="1" Spacing="2"
                                VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}"
                                 Style="{StaticResource BodyLarge}" />
                      <TextBlock Text="{Binding Description}"
                                 Style="{StaticResource BodySmall}"
                                 Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>
          </StackPanel>

          <!-- Checkable items -->
          <StackPanel Grid.Column="1" Spacing="12">
            <TextBlock Text="Checkable items" Style="{StaticResource LabelLarge}" />
            <ItemsRepeater ItemsSource="{Binding CheckableItems}">
              <ItemsRepeater.Layout>
                <StackLayout Spacing="0" />
              </ItemsRepeater.Layout>
              <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="local:CheckableItem">
                  <Border Padding="8,12"
                          BorderBrush="{ThemeResource OutlineBrush}"
                          BorderThickness="0,0,0,1">
                    <Grid ColumnSpacing="12">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <CheckBox Grid.Column="0"
                                IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                VerticalAlignment="Center"
                                MinWidth="0" />
                      <StackPanel Grid.Column="1" Spacing="2"
                                  VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}"
                                   Style="{StaticResource BodyLarge}" />
                        <TextBlock Text="{Binding Description}"
                                   Style="{StaticResource BodySmall}"
                                   Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
          </StackPanel>
        </Grid>
      </Border>

      <!-- ═══════ Section 3: Grid-style List ═══════ -->
      <TextBlock Text="Grid-style List"
                 Style="{StaticResource TitleLarge}" />

      <TextBlock Text="A tabular layout using ItemsRepeater with column headers, replacing WPF's ListView.GridView."
                 Style="{StaticResource BodyMedium}"
                 Foreground="{ThemeResource OnSurfaceVariantBrush}" />

      <Border Background="{ThemeResource SurfaceVariantBrush}"
              CornerRadius="16" Padding="24"
              Translation="0,0,16">
        <Border.Shadow>
          <ThemeShadow />
        </Border.Shadow>

        <StackPanel Spacing="0">
          <!-- Column headers -->
          <Grid Padding="8,12"
                Background="{ThemeResource PrimaryContainerBrush}"
                CornerRadius="8,8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="60" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Code"
                       Style="{StaticResource LabelLarge}" />
            <TextBlock Grid.Column="1" Text="Name"
                       Style="{StaticResource LabelLarge}" />
            <TextBlock Grid.Column="2" Text="Description"
                       Style="{StaticResource LabelLarge}" />
          </Grid>

          <!-- Rows -->
          <ItemsRepeater ItemsSource="{Binding GridItems}">
            <ItemsRepeater.Layout>
              <StackLayout Spacing="0" />
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
              <DataTemplate x:DataType="local:GridRowItem">
                <Grid Padding="8,12"
                      BorderBrush="{ThemeResource OutlineBrush}"
                      BorderThickness="0,0,0,1">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="2*" />
                  </Grid.ColumnDefinitions>
                  <Border Grid.Column="0"
                          Width="32" Height="32"
                          CornerRadius="16"
                          Background="{ThemeResource TertiaryContainerBrush}"
                          HorizontalAlignment="Left">
                    <TextBlock Text="{Binding Code}"
                               Style="{StaticResource LabelMedium}"
                               Foreground="{ThemeResource OnTertiaryContainerBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                  </Border>
                  <TextBlock Grid.Column="1"
                             Text="{Binding Name}"
                             Style="{StaticResource BodyMedium}"
                             VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2"
                             Text="{Binding Description}"
                             Style="{StaticResource BodyMedium}"
                             Foreground="{ThemeResource OnSurfaceVariantBrush}"
                             VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ItemsRepeater.ItemTemplate>
          </ItemsRepeater>
        </StackPanel>
      </Border>

      <!-- ═══════ Section 4: Interactive Controls ═══════ -->
      <TextBlock Text="Interactive Controls"
                 Style="{StaticResource TitleLarge}" />

      <Border Background="{ThemeResource SurfaceVariantBrush}"
              CornerRadius="16" Padding="24"
              Translation="0,0,16">
        <Border.Shadow>
          <ThemeShadow />
        </Border.Shadow>

        <StackPanel Spacing="16">
          <ToggleSwitch Header="Lists Enabled"
                        IsOn="{Binding ListEnabled, Mode=TwoWay}"
                        AutomationProperties.Name="Toggle lists enabled" />

          <StackPanel Spacing="4">
            <TextBlock Text="Selected simple item:" Style="{StaticResource LabelLarge}" />
            <TextBlock Style="{StaticResource BodyMedium}"
                       Foreground="{ThemeResource OnSurfaceVariantBrush}">
              <Run Text="{Binding SelectedSimpleItem}" />
            </TextBlock>
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Text="Selected project:" Style="{StaticResource LabelLarge}" />
            <TextBlock Style="{StaticResource BodyMedium}"
                       Foreground="{ThemeResource OnSurfaceVariantBrush}">
              <Run Text="{Binding SelectedProject.Name}" />
            </TextBlock>
          </StackPanel>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</Page>
