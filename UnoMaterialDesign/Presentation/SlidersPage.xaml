<Page x:Class="UnoMaterialDesign.Presentation.SlidersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:ut="using:Uno.Themes"
      Background="{ThemeResource SurfaceBrush}">

  <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
    <StackPanel Padding="32"
                Spacing="32"
                MaxWidth="960"
                HorizontalAlignment="Center">

      <!-- ==================== SECTION 1: Continuous Horizontal ==================== -->
      <TextBlock x:Uid="SlidersPage_ContinuousHTitle"
                 Text="Continuous: Horizontal"
                 Style="{StaticResource HeadlineMedium}" />

      <Border Background="{ThemeResource SurfaceVariantBrush}"
              CornerRadius="16"
              Padding="24"
              Translation="0,0,8">
        <Border.Shadow>
          <ThemeShadow />
        </Border.Shadow>
        <StackPanel Spacing="24">
          <!-- Standard -->
          <StackPanel Spacing="4">
            <TextBlock x:Uid="SlidersPage_StandardLabel"
                       Text="Standard"
                       Style="{StaticResource LabelLarge}" />
            <Slider x:Uid="SlidersPage_ContinuousH1"
                    Minimum="0"
                    Maximum="50"
                    Value="{Binding ContinuousValue, Mode=TwoWay}"
                    AutomationProperties.Name="Continuous Horizontal" />
          </StackPanel>

          <!-- With tick marks -->
          <StackPanel Spacing="4">
            <TextBlock x:Uid="SlidersPage_TickedLabel"
                       Text="With Tick Marks"
                       Style="{StaticResource LabelLarge}" />
            <Slider x:Uid="SlidersPage_ContinuousH2"
                    Minimum="0"
                    Maximum="50"
                    TickFrequency="5"
                    TickPlacement="Outside"
                    Value="{Binding TickedValue, Mode=TwoWay}"
                    AutomationProperties.Name="Ticked Horizontal" />
          </StackPanel>

          <!-- Disabled -->
          <StackPanel Spacing="4">
            <TextBlock x:Uid="SlidersPage_DisabledLabel"
                       Text="Disabled"
                       Style="{StaticResource LabelLarge}" />
            <Slider x:Uid="SlidersPage_ContinuousH3"
                    Minimum="0"
                    Maximum="50"
                    Value="{Binding DisabledValue, Mode=TwoWay}"
                    IsEnabled="False"
                    AutomationProperties.Name="Disabled Horizontal" />
          </StackPanel>

          <!-- With StepFrequency -->
          <StackPanel Spacing="4">
            <TextBlock x:Uid="SlidersPage_StepLabel"
                       Text="Step Frequency (5)"
                       Style="{StaticResource LabelLarge}" />
            <Slider x:Uid="SlidersPage_ContinuousH4"
                    Minimum="0"
                    Maximum="50"
                    StepFrequency="5"
                    Value="20"
                    AutomationProperties.Name="Step Frequency Horizontal" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- ==================== SECTION 2: Continuous Vertical ==================== -->
      <TextBlock x:Uid="SlidersPage_ContinuousVTitle"
                 Text="Continuous: Vertical"
                 Style="{StaticResource HeadlineMedium}" />

      <Border Background="{ThemeResource SurfaceVariantBrush}"
              CornerRadius="16"
              Padding="24"
              Translation="0,0,8"
              MinHeight="280">
        <Border.Shadow>
          <ThemeShadow />
        </Border.Shadow>
        <StackPanel Spacing="16">
          <TextBlock x:Uid="SlidersPage_ContinuousVDesc"
                     Text="Vertical sliders with various configurations."
                     Style="{StaticResource BodyMedium}"
                     Foreground="{ThemeResource OnSurfaceVariantBrush}" />

          <Grid ColumnSpacing="32" Height="200">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="4" HorizontalAlignment="Center">
              <TextBlock Text="Standard" Style="{StaticResource LabelSmall}" HorizontalAlignment="Center" />
              <Slider x:Uid="SlidersPage_ContinuousV1"
                      Minimum="0"
                      Maximum="50"
                      Orientation="Vertical"
                      Value="25"
                      AutomationProperties.Name="Continuous Vertical Standard" />
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="4" HorizontalAlignment="Center">
              <TextBlock Text="Ticked" Style="{StaticResource LabelSmall}" HorizontalAlignment="Center" />
              <Slider x:Uid="SlidersPage_ContinuousV2"
                      Minimum="0"
                      Maximum="50"
                      Orientation="Vertical"
                      TickFrequency="10"
                      TickPlacement="Outside"
                      Value="30"
                      AutomationProperties.Name="Continuous Vertical Ticked" />
            </StackPanel>

            <StackPanel Grid.Column="2" Spacing="4" HorizontalAlignment="Center">
              <TextBlock Text="Step=10" Style="{StaticResource LabelSmall}" HorizontalAlignment="Center" />
              <Slider x:Uid="SlidersPage_ContinuousV3"
                      Minimum="0"
                      Maximum="50"
                      Orientation="Vertical"
                      StepFrequency="10"
                      Value="10"
                      AutomationProperties.Name="Continuous Vertical Step" />
            </StackPanel>

            <StackPanel Grid.Column="3" Spacing="4" HorizontalAlignment="Center">
              <TextBlock Text="Disabled" Style="{StaticResource LabelSmall}" HorizontalAlignment="Center" />
              <Slider x:Uid="SlidersPage_ContinuousV4"
                      Minimum="0"
                      Maximum="50"
                      Orientation="Vertical"
                      Value="30"
                      IsEnabled="False"
                      AutomationProperties.Name="Continuous Vertical Disabled" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>

      <!-- ==================== SECTION 3: Discrete Horizontal ==================== -->
      <TextBlock x:Uid="SlidersPage_DiscreteHTitle"
                 Text="Discrete: Horizontal"
                 Style="{StaticResource HeadlineMedium}" />

      <Border Background="{ThemeResource SurfaceVariantBrush}"
              CornerRadius="16"
              Padding="24"
              Translation="0,0,8">
        <Border.Shadow>
          <ThemeShadow />
        </Border.Shadow>
        <StackPanel Spacing="20">
          <!-- Configurable max/tick -->
          <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBox x:Uid="SlidersPage_DiscreteHMax"
                     Header="Maximum"
                     Text="{Binding DiscreteMax, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     InputScope="Number"
                     AutomationProperties.Name="Discrete Horizontal Maximum" />

            <TextBox x:Uid="SlidersPage_DiscreteHTick"
                     Grid.Column="1"
                     Header="Tick Frequency"
                     Text="{Binding DiscreteTick, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     InputScope="Number"
                     AutomationProperties.Name="Discrete Horizontal Tick" />
          </Grid>

          <!-- Standard discrete -->
          <StackPanel Spacing="4">
            <TextBlock Text="Standard Discrete" Style="{StaticResource LabelLarge}" />
            <Slider x:Uid="SlidersPage_DiscreteH1"
                    Minimum="0"
                    Maximum="{Binding DiscreteMax}"
                    StepFrequency="{Binding DiscreteTick}"
                    TickFrequency="{Binding DiscreteTick}"
                    TickPlacement="Outside"
                    Value="{Binding DiscreteValue, Mode=TwoWay}"
                    AutomationProperties.Name="Discrete Horizontal Standard" />
          </StackPanel>

          <!-- Tick marks both sides -->
          <StackPanel Spacing="4">
            <TextBlock Text="Ticks on Both Sides" Style="{StaticResource LabelLarge}" />
            <Slider x:Uid="SlidersPage_DiscreteH2"
                    Minimum="0"
                    Maximum="{Binding DiscreteMax}"
                    StepFrequency="{Binding DiscreteTick}"
                    TickFrequency="{Binding DiscreteTick}"
                    TickPlacement="Outside"
                    Value="60"
                    AutomationProperties.Name="Discrete Horizontal Both Ticks" />
          </StackPanel>

          <!-- Disabled discrete -->
          <StackPanel Spacing="4">
            <TextBlock Text="Disabled Discrete" Style="{StaticResource LabelLarge}" />
            <Slider x:Uid="SlidersPage_DiscreteH3"
                    Minimum="0"
                    Maximum="{Binding DiscreteMax}"
                    StepFrequency="{Binding DiscreteTick}"
                    TickFrequency="{Binding DiscreteTick}"
                    TickPlacement="Outside"
                    Value="50"
                    IsEnabled="False"
                    AutomationProperties.Name="Discrete Horizontal Disabled" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- ==================== SECTION 4: Discrete Vertical ==================== -->
      <TextBlock x:Uid="SlidersPage_DiscreteVTitle"
                 Text="Discrete: Vertical"
                 Style="{StaticResource HeadlineMedium}" />

      <Border Background="{ThemeResource SurfaceVariantBrush}"
              CornerRadius="16"
              Padding="24"
              Translation="0,0,8"
              MinHeight="320">
        <Border.Shadow>
          <ThemeShadow />
        </Border.Shadow>
        <StackPanel Spacing="16">
          <!-- Configurable max/tick -->
          <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBox x:Uid="SlidersPage_DiscreteVMax"
                     Header="Maximum"
                     Text="{Binding DiscreteVertMax, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     InputScope="Number"
                     AutomationProperties.Name="Discrete Vertical Maximum" />

            <TextBox x:Uid="SlidersPage_DiscreteVTick"
                     Grid.Column="1"
                     Header="Tick Frequency"
                     Text="{Binding DiscreteVertTick, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     InputScope="Number"
                     AutomationProperties.Name="Discrete Vertical Tick" />
          </Grid>

          <Grid ColumnSpacing="32" Height="200">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="4" HorizontalAlignment="Center">
              <TextBlock Text="Standard" Style="{StaticResource LabelSmall}" HorizontalAlignment="Center" />
              <Slider x:Uid="SlidersPage_DiscreteV1"
                      Minimum="0"
                      Maximum="{Binding DiscreteVertMax}"
                      Orientation="Vertical"
                      StepFrequency="{Binding DiscreteVertTick}"
                      TickFrequency="{Binding DiscreteVertTick}"
                      TickPlacement="Outside"
                      Value="{Binding DiscreteVertValue, Mode=TwoWay}"
                      AutomationProperties.Name="Discrete Vertical Standard" />
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="4" HorizontalAlignment="Center">
              <TextBlock Text="Ticked" Style="{StaticResource LabelSmall}" HorizontalAlignment="Center" />
              <Slider x:Uid="SlidersPage_DiscreteV2"
                      Minimum="0"
                      Maximum="{Binding DiscreteVertMax}"
                      Orientation="Vertical"
                      StepFrequency="{Binding DiscreteVertTick}"
                      TickFrequency="{Binding DiscreteVertTick}"
                      TickPlacement="Outside"
                      Value="30000"
                      AutomationProperties.Name="Discrete Vertical Ticked" />
            </StackPanel>

            <StackPanel Grid.Column="2" Spacing="4" HorizontalAlignment="Center">
              <TextBlock Text="Both" Style="{StaticResource LabelSmall}" HorizontalAlignment="Center" />
              <Slider x:Uid="SlidersPage_DiscreteV3"
                      Minimum="0"
                      Maximum="{Binding DiscreteVertMax}"
                      Orientation="Vertical"
                      StepFrequency="{Binding DiscreteVertTick}"
                      TickFrequency="{Binding DiscreteVertTick}"
                      TickPlacement="Outside"
                      Value="90000"
                      AutomationProperties.Name="Discrete Vertical Both" />
            </StackPanel>

            <StackPanel Grid.Column="3" Spacing="4" HorizontalAlignment="Center">
              <TextBlock Text="Disabled" Style="{StaticResource LabelSmall}" HorizontalAlignment="Center" />
              <Slider x:Uid="SlidersPage_DiscreteV4"
                      Minimum="0"
                      Maximum="{Binding DiscreteVertMax}"
                      Orientation="Vertical"
                      StepFrequency="{Binding DiscreteVertTick}"
                      TickFrequency="{Binding DiscreteVertTick}"
                      TickPlacement="Outside"
                      Value="70000"
                      IsEnabled="False"
                      AutomationProperties.Name="Discrete Vertical Disabled" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>

      <!-- ==================== SECTION 5: Interactive Demo ==================== -->
      <TextBlock x:Uid="SlidersPage_InteractiveTitle"
                 Text="Interactive Demo"
                 Style="{StaticResource HeadlineMedium}" />

      <Border Background="{ThemeResource SurfaceVariantBrush}"
              CornerRadius="16"
              Padding="24"
              Translation="0,0,8">
        <Border.Shadow>
          <ThemeShadow />
        </Border.Shadow>
        <StackPanel Spacing="16">
          <TextBlock x:Uid="SlidersPage_InteractiveDesc"
                     Text="Adjust the slider and see the value update in real time."
                     Style="{StaticResource TitleMedium}" />

          <ToggleSwitch x:Uid="SlidersPage_SliderEnabled"
                        Header="Enabled"
                        IsOn="{Binding SliderEnabled, Mode=TwoWay}"
                        AutomationProperties.Name="Slider Enabled" />

          <Slider x:Uid="SlidersPage_InteractiveSlider"
                  Minimum="0"
                  Maximum="100"
                  StepFrequency="1"
                  Value="{Binding InteractiveValue, Mode=TwoWay}"
                  IsEnabled="{Binding SliderEnabled}"
                  Header="Volume"
                  AutomationProperties.Name="Interactive Slider" />

          <Border Background="{ThemeResource SurfaceBrush}"
                  CornerRadius="12"
                  Padding="16">
            <TextBlock Style="{StaticResource BodyLarge}"
                       Foreground="{ThemeResource PrimaryBrush}">
              <Run Text="Current Value:" />
              <Run Text="{Binding InteractiveValue}" FontWeight="Bold" />
            </TextBlock>
          </Border>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</Page>
