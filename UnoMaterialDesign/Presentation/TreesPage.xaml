<Page x:Class="UnoMaterialDesign.Presentation.TreesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:ut="using:Uno.Themes"
      xmlns:local="using:UnoMaterialDesign.Presentation"
      Background="{ThemeResource SurfaceBrush}">

  <ScrollViewer>
    <StackPanel Padding="32" Spacing="32" MaxWidth="960"
                HorizontalAlignment="Stretch">

      <!-- Page Header -->
      <TextBlock x:Uid="TreesPage.Title"
                 Text="Trees"
                 Style="{StaticResource HeadlineLarge}" />
      <TextBlock x:Uid="TreesPage.Subtitle"
                 Text="Hierarchical data display using TreeView with static and data-bound nodes."
                 Style="{StaticResource BodyLarge}"
                 Foreground="{ThemeResource OnSurfaceVariantBrush}" />

      <!-- ═══════ Section 1: Basic Tree View ═══════ -->
      <TextBlock Text="Basic Tree View"
                 Style="{StaticResource TitleLarge}" />

      <Grid ColumnSpacing="24">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Fruit tree -->
        <Border Grid.Column="0"
                Background="{ThemeResource SurfaceVariantBrush}"
                CornerRadius="16" Padding="24"
                Translation="0,0,16">
          <Border.Shadow>
            <ThemeShadow />
          </Border.Shadow>
          <StackPanel Spacing="12">
            <TextBlock Text="Fruit" Style="{StaticResource LabelLarge}" />
            <TreeView>
              <TreeView.RootNodes>
                <TreeViewNode Content="Fruit" IsExpanded="True">
                  <TreeViewNode.Children>
                    <TreeViewNode Content="🍎 Apple" />
                    <TreeViewNode Content="🍌 Banana" />
                    <TreeViewNode Content="🍇 Grape">
                      <TreeViewNode.Children>
                        <TreeViewNode Content="Red Grape" />
                        <TreeViewNode Content="Green Grape" />
                      </TreeViewNode.Children>
                    </TreeViewNode>
                    <TreeViewNode Content="🍑 Peach" />
                    <TreeViewNode Content="🍐 Pear" />
                    <TreeViewNode Content="🍓 Strawberry" />
                  </TreeViewNode.Children>
                </TreeViewNode>
              </TreeView.RootNodes>
            </TreeView>
          </StackPanel>
        </Border>

        <!-- OS tree -->
        <Border Grid.Column="1"
                Background="{ThemeResource SurfaceVariantBrush}"
                CornerRadius="16" Padding="24"
                Translation="0,0,16">
          <Border.Shadow>
            <ThemeShadow />
          </Border.Shadow>
          <StackPanel Spacing="12">
            <TextBlock Text="Operating Systems" Style="{StaticResource LabelLarge}" />
            <TreeView>
              <TreeView.RootNodes>
                <TreeViewNode Content="Operating Systems" IsExpanded="True">
                  <TreeViewNode.Children>
                    <TreeViewNode Content="Amiga" />
                    <TreeViewNode Content="Android" />
                    <TreeViewNode Content="iOS" />
                    <TreeViewNode Content="Linux" IsExpanded="True">
                      <TreeViewNode.Children>
                        <TreeViewNode Content="Ubuntu" />
                        <TreeViewNode Content="Fedora" />
                        <TreeViewNode Content="Arch" />
                      </TreeViewNode.Children>
                    </TreeViewNode>
                    <TreeViewNode Content="Windows" IsExpanded="True">
                      <TreeViewNode.Children>
                        <TreeViewNode Content="Windows 10" />
                        <TreeViewNode Content="Windows 11" />
                      </TreeViewNode.Children>
                    </TreeViewNode>
                  </TreeViewNode.Children>
                </TreeViewNode>
              </TreeView.RootNodes>
            </TreeView>
          </StackPanel>
        </Border>
      </Grid>

      <!-- ═══════ Section 2: Data-Bound Tree View ═══════ -->
      <TextBlock Text="Data-Bound Tree View"
                 Style="{StaticResource TitleLarge}" />

      <Border Background="{ThemeResource SurfaceVariantBrush}"
              CornerRadius="16" Padding="24"
              Translation="0,0,16">
        <Border.Shadow>
          <ThemeShadow />
        </Border.Shadow>

        <StackPanel Spacing="16">
          <TextBlock Text="Movie categories with hierarchical data template"
                     Style="{StaticResource BodyMedium}"
                     Foreground="{ThemeResource OnSurfaceVariantBrush}" />

          <TreeView ItemsSource="{Binding MovieCategories}">
            <TreeView.ItemTemplate>
              <DataTemplate x:DataType="local:MovieCategory">
                <TreeViewItem ItemsSource="{Binding Movies}"
                              Content="{Binding Name}"
                              IsExpanded="True" />
              </DataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>

          <StackPanel Orientation="Horizontal" Spacing="12">
            <Button Content="Add Movie"
                    Command="{Binding AddMovieCommand}"
                    Style="{StaticResource FilledTonalButtonStyle}">
              <ut:ControlExtensions.Icon>
                <FontIcon Glyph="&#xE710;" FontSize="16" />
              </ut:ControlExtensions.Icon>
            </Button>
            <Button Content="Add Category"
                    Command="{Binding AddCategoryCommand}"
                    Style="{StaticResource OutlinedButtonStyle}">
              <ut:ControlExtensions.Icon>
                <FontIcon Glyph="&#xE8F4;" FontSize="16" />
              </ut:ControlExtensions.Icon>
            </Button>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- ═══════ Section 3: Solar System ═══════ -->
      <TextBlock Text="Planet Data"
                 Style="{StaticResource TitleLarge}" />

      <Border Background="{ThemeResource SurfaceVariantBrush}"
              CornerRadius="16" Padding="24"
              Translation="0,0,16">
        <Border.Shadow>
          <ThemeShadow />
        </Border.Shadow>

        <StackPanel Spacing="16">
          <TextBlock Text="Solar system planets displayed in a tree with detail cards"
                     Style="{StaticResource BodyMedium}"
                     Foreground="{ThemeResource OnSurfaceVariantBrush}" />

          <TreeView>
            <TreeView.RootNodes>
              <TreeViewNode Content="🌌 Solar System" IsExpanded="True">
                <TreeViewNode.Children>
                  <TreeViewNode Content="☿ Mercury" />
                  <TreeViewNode Content="♀ Venus" />
                  <TreeViewNode Content="🌍 Earth" />
                  <TreeViewNode Content="♂ Mars" />
                  <TreeViewNode Content="♃ Jupiter" />
                  <TreeViewNode Content="♄ Saturn" />
                  <TreeViewNode Content="♅ Uranus" />
                  <TreeViewNode Content="♆ Neptune" />
                </TreeViewNode.Children>
              </TreeViewNode>
            </TreeView.RootNodes>
          </TreeView>

          <Border Height="1" Background="{ThemeResource OutlineBrush}" Margin="0,4" />

          <TextBlock Text="Planet details" Style="{StaticResource LabelLarge}" />

          <ItemsRepeater ItemsSource="{Binding Planets}">
            <ItemsRepeater.Layout>
              <StackLayout Spacing="8" />
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
              <DataTemplate x:DataType="local:PlanetInfo">
                <Border Background="{ThemeResource SurfaceBrush}"
                        CornerRadius="12" Padding="16"
                        Translation="0,0,4">
                  <Border.Shadow>
                    <ThemeShadow />
                  </Border.Shadow>
                  <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="120" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding Name}"
                               Style="{StaticResource TitleSmall}"
                               VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" Spacing="2">
                      <TextBlock Text="From Sun"
                                 Style="{StaticResource LabelSmall}"
                                 Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                      <TextBlock Style="{StaticResource BodySmall}">
                        <Run Text="{Binding DistanceFromSun}" />
                        <Run Text=" AU" />
                      </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Spacing="2">
                      <TextBlock Text="From Earth"
                                 Style="{StaticResource LabelSmall}"
                                 Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                      <TextBlock Style="{StaticResource BodySmall}">
                        <Run Text="{Binding DistanceFromEarth}" />
                        <Run Text=" AU" />
                      </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Spacing="2">
                      <TextBlock Text="Velocity"
                                 Style="{StaticResource LabelSmall}"
                                 Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                      <TextBlock Style="{StaticResource BodySmall}">
                        <Run Text="{Binding Velocity}" />
                        <Run Text=" km/s" />
                      </TextBlock>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsRepeater.ItemTemplate>
          </ItemsRepeater>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</Page>
