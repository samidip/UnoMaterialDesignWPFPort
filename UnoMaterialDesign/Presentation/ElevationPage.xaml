<Page x:Class="UnoMaterialDesign.Presentation.ElevationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:ut="using:Uno.Themes"
      Background="{ThemeResource SurfaceBrush}">

  <ScrollViewer>
    <StackPanel Padding="32" Spacing="32" MaxWidth="960"
                HorizontalAlignment="Stretch">

      <!-- Page Header -->
      <TextBlock x:Uid="ElevationPage.Title"
                 Text="Elevation"
                 Style="{StaticResource HeadlineLarge}" />
      <TextBlock x:Uid="ElevationPage.Subtitle"
                 Text="Elevation creates depth using shadows. Controls have default elevation, but it can be overridden via Translation Z values and ThemeShadow."
                 Style="{StaticResource BodyLarge}"
                 Foreground="{ThemeResource OnSurfaceVariantBrush}" />

      <!-- ═══════ Section 1: Elevated Buttons ═══════ -->
      <TextBlock Text="Elevated Buttons"
                 Style="{StaticResource TitleLarge}" />

      <Border Background="{ThemeResource SurfaceVariantBrush}"
              CornerRadius="16" Padding="24"
              Translation="0,0,16">
        <Border.Shadow>
          <ThemeShadow />
        </Border.Shadow>

        <StackPanel Spacing="16">
          <TextBlock Text="Filled buttons at increasing elevation depths"
                     Style="{StaticResource BodyMedium}"
                     Foreground="{ThemeResource OnSurfaceVariantBrush}" />

          <!-- Row of raised buttons -->
          <StackPanel Orientation="Horizontal" Spacing="16">
            <Button Content="0 dp" Style="{StaticResource FilledButtonStyle}" />

            <Button Content="4 dp" Style="{StaticResource FilledButtonStyle}"
                    Translation="0,0,4">
              <Button.Shadow>
                <ThemeShadow />
              </Button.Shadow>
            </Button>

            <Button Content="8 dp" Style="{StaticResource FilledButtonStyle}"
                    Translation="0,0,8">
              <Button.Shadow>
                <ThemeShadow />
              </Button.Shadow>
            </Button>

            <Button Content="16 dp" Style="{StaticResource FilledButtonStyle}"
                    Translation="0,0,16">
              <Button.Shadow>
                <ThemeShadow />
              </Button.Shadow>
            </Button>

            <Button Content="32 dp" Style="{StaticResource FilledButtonStyle}"
                    Translation="0,0,32">
              <Button.Shadow>
                <ThemeShadow />
              </Button.Shadow>
            </Button>
          </StackPanel>

          <Border Height="1" Background="{ThemeResource OutlineBrush}" Margin="0,8" />

          <TextBlock Text="FABs at different elevation depths"
                     Style="{StaticResource BodyMedium}"
                     Foreground="{ThemeResource OnSurfaceVariantBrush}" />

          <!-- Row of FABs -->
          <StackPanel Orientation="Horizontal" Spacing="16">
            <Button Style="{StaticResource SmallFabStyle}">
              <ut:ControlExtensions.Icon>
                <FontIcon Glyph="&#xE710;" FontSize="16" />
              </ut:ControlExtensions.Icon>
            </Button>

            <Button Style="{StaticResource FabStyle}"
                    Translation="0,0,8">
              <Button.Shadow>
                <ThemeShadow />
              </Button.Shadow>
              <ut:ControlExtensions.Icon>
                <FontIcon Glyph="&#xE710;" FontSize="20" />
              </ut:ControlExtensions.Icon>
            </Button>

            <Button Style="{StaticResource LargeFabStyle}"
                    Translation="0,0,16">
              <Button.Shadow>
                <ThemeShadow />
              </Button.Shadow>
              <ut:ControlExtensions.Icon>
                <FontIcon Glyph="&#xE710;" FontSize="24" />
              </ut:ControlExtensions.Icon>
            </Button>

            <Button Style="{StaticResource SurfaceFabStyle}"
                    Translation="0,0,24">
              <Button.Shadow>
                <ThemeShadow />
              </Button.Shadow>
              <ut:ControlExtensions.Icon>
                <FontIcon Glyph="&#xE710;" FontSize="20" />
              </ut:ControlExtensions.Icon>
            </Button>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- ═══════ Section 2: Card Elevation Levels ═══════ -->
      <TextBlock Text="Card Elevation Levels"
                 Style="{StaticResource TitleLarge}" />

      <TextBlock Text="Cards shown at increasing Translation Z values to demonstrate shadow depth."
                 Style="{StaticResource BodyMedium}"
                 Foreground="{ThemeResource OnSurfaceVariantBrush}" />

      <Grid ColumnSpacing="16" RowSpacing="16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row 1: Z=0, Z=2, Z=4, Z=8 -->
        <Border Grid.Row="0" Grid.Column="0"
                Background="{ThemeResource SurfaceBrush}"
                CornerRadius="12" Padding="16"
                MinHeight="80"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
          <TextBlock Text="0 dp" Style="{StaticResource TitleMedium}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />
        </Border>

        <Border Grid.Row="0" Grid.Column="1"
                Background="{ThemeResource SurfaceBrush}"
                CornerRadius="12" Padding="16"
                MinHeight="80"
                Translation="0,0,2">
          <Border.Shadow>
            <ThemeShadow />
          </Border.Shadow>
          <TextBlock Text="2 dp" Style="{StaticResource TitleMedium}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />
        </Border>

        <Border Grid.Row="0" Grid.Column="2"
                Background="{ThemeResource SurfaceBrush}"
                CornerRadius="12" Padding="16"
                MinHeight="80"
                Translation="0,0,4">
          <Border.Shadow>
            <ThemeShadow />
          </Border.Shadow>
          <TextBlock Text="4 dp" Style="{StaticResource TitleMedium}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />
        </Border>

        <Border Grid.Row="0" Grid.Column="3"
                Background="{ThemeResource SurfaceBrush}"
                CornerRadius="12" Padding="16"
                MinHeight="80"
                Translation="0,0,8">
          <Border.Shadow>
            <ThemeShadow />
          </Border.Shadow>
          <TextBlock Text="8 dp" Style="{StaticResource TitleMedium}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />
        </Border>

        <!-- Row 2: Z=12, Z=16, Z=24, Z=32 -->
        <Border Grid.Row="1" Grid.Column="0"
                Background="{ThemeResource SurfaceBrush}"
                CornerRadius="12" Padding="16"
                MinHeight="80"
                Translation="0,0,12">
          <Border.Shadow>
            <ThemeShadow />
          </Border.Shadow>
          <TextBlock Text="12 dp" Style="{StaticResource TitleMedium}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />
        </Border>

        <Border Grid.Row="1" Grid.Column="1"
                Background="{ThemeResource SurfaceBrush}"
                CornerRadius="12" Padding="16"
                MinHeight="80"
                Translation="0,0,16">
          <Border.Shadow>
            <ThemeShadow />
          </Border.Shadow>
          <TextBlock Text="16 dp" Style="{StaticResource TitleMedium}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />
        </Border>

        <Border Grid.Row="1" Grid.Column="2"
                Background="{ThemeResource SurfaceBrush}"
                CornerRadius="12" Padding="16"
                MinHeight="80"
                Translation="0,0,24">
          <Border.Shadow>
            <ThemeShadow />
          </Border.Shadow>
          <TextBlock Text="24 dp" Style="{StaticResource TitleMedium}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />
        </Border>

        <Border Grid.Row="1" Grid.Column="3"
                Background="{ThemeResource SurfaceBrush}"
                CornerRadius="12" Padding="16"
                MinHeight="80"
                Translation="0,0,32">
          <Border.Shadow>
            <ThemeShadow />
          </Border.Shadow>
          <TextBlock Text="32 dp" Style="{StaticResource TitleMedium}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />
        </Border>
      </Grid>

      <!-- ═══════ Section 3: Toolkit Card Styles ═══════ -->
      <TextBlock Text="Toolkit Card Styles"
                 Style="{StaticResource TitleLarge}" />

      <TextBlock Text="Uno Toolkit Card and CardContentControl with built-in elevation styles."
                 Style="{StaticResource BodyMedium}"
                 Foreground="{ThemeResource OnSurfaceVariantBrush}" />

      <Grid ColumnSpacing="16" RowSpacing="16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Elevated Card -->
        <utu:Card Grid.Column="0"
                  Style="{StaticResource ElevatedCardStyle}"
                  MinHeight="100"
                  HorizontalContentAlignment="Center"
                  VerticalContentAlignment="Center">
          <StackPanel Spacing="8" HorizontalAlignment="Center">
            <TextBlock Text="Elevated" Style="{StaticResource TitleSmall}"
                       HorizontalAlignment="Center" />
            <TextBlock Text="ElevatedCardStyle"
                       Style="{StaticResource LabelSmall}"
                       Foreground="{ThemeResource OnSurfaceVariantBrush}"
                       HorizontalAlignment="Center" />
          </StackPanel>
        </utu:Card>

        <!-- Filled Card -->
        <utu:Card Grid.Column="1"
                  Style="{StaticResource FilledCardStyle}"
                  MinHeight="100"
                  HorizontalContentAlignment="Center"
                  VerticalContentAlignment="Center">
          <StackPanel Spacing="8" HorizontalAlignment="Center">
            <TextBlock Text="Filled" Style="{StaticResource TitleSmall}"
                       HorizontalAlignment="Center" />
            <TextBlock Text="FilledCardStyle"
                       Style="{StaticResource LabelSmall}"
                       Foreground="{ThemeResource OnSurfaceVariantBrush}"
                       HorizontalAlignment="Center" />
          </StackPanel>
        </utu:Card>

        <!-- Outlined Card -->
        <utu:Card Grid.Column="2"
                  Style="{StaticResource OutlinedCardStyle}"
                  MinHeight="100"
                  HorizontalContentAlignment="Center"
                  VerticalContentAlignment="Center">
          <StackPanel Spacing="8" HorizontalAlignment="Center">
            <TextBlock Text="Outlined" Style="{StaticResource TitleSmall}"
                       HorizontalAlignment="Center" />
            <TextBlock Text="OutlinedCardStyle"
                       Style="{StaticResource LabelSmall}"
                       Foreground="{ThemeResource OnSurfaceVariantBrush}"
                       HorizontalAlignment="Center" />
          </StackPanel>
        </utu:Card>
      </Grid>

      <!-- ═══════ Section 4: Corner Radius Variations ═══════ -->
      <TextBlock Text="Shape &amp; Corner Radius"
                 Style="{StaticResource TitleLarge}" />

      <TextBlock Text="Elevated surfaces with different corner radii to show how shape interacts with shadows."
                 Style="{StaticResource BodyMedium}"
                 Foreground="{ThemeResource OnSurfaceVariantBrush}" />

      <StackPanel Orientation="Horizontal" Spacing="16">
        <!-- Square corners -->
        <Border Background="{ThemeResource SurfaceBrush}"
                CornerRadius="0" Padding="16"
                Width="120" Height="80"
                Translation="0,0,16">
          <Border.Shadow>
            <ThemeShadow />
          </Border.Shadow>
          <TextBlock Text="0 radius" Style="{StaticResource LabelMedium}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />
        </Border>

        <!-- Rounded 8 -->
        <Border Background="{ThemeResource SurfaceBrush}"
                CornerRadius="8" Padding="16"
                Width="120" Height="80"
                Translation="0,0,16">
          <Border.Shadow>
            <ThemeShadow />
          </Border.Shadow>
          <TextBlock Text="8 radius" Style="{StaticResource LabelMedium}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />
        </Border>

        <!-- Rounded 16 -->
        <Border Background="{ThemeResource SurfaceBrush}"
                CornerRadius="16" Padding="16"
                Width="120" Height="80"
                Translation="0,0,16">
          <Border.Shadow>
            <ThemeShadow />
          </Border.Shadow>
          <TextBlock Text="16 radius" Style="{StaticResource LabelMedium}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />
        </Border>

        <!-- Rounded 28 -->
        <Border Background="{ThemeResource SurfaceBrush}"
                CornerRadius="28" Padding="16"
                Width="120" Height="80"
                Translation="0,0,16">
          <Border.Shadow>
            <ThemeShadow />
          </Border.Shadow>
          <TextBlock Text="28 radius" Style="{StaticResource LabelMedium}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />
        </Border>

        <!-- Pill / full round -->
        <Border Background="{ThemeResource SurfaceBrush}"
                CornerRadius="40" Padding="16"
                Width="120" Height="80"
                Translation="0,0,16">
          <Border.Shadow>
            <ThemeShadow />
          </Border.Shadow>
          <TextBlock Text="40 radius" Style="{StaticResource LabelMedium}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />
        </Border>
      </StackPanel>

    </StackPanel>
  </ScrollViewer>
</Page>
