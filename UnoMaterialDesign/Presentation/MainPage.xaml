<Page x:Class="UnoMaterialDesign.Presentation.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:UnoMaterialDesign.Presentation"
      xmlns:uen="using:Uno.Extensions.Navigation.UI"
      xmlns:utu="using:Uno.Toolkit.UI"
      NavigationCacheMode="Required"
      Background="{ThemeResource BackgroundBrush}">

  <Grid uen:Region.Attached="True"
        utu:SafeArea.Insets="VisibleBounds">
    <NavigationView x:Name="NavigationViewControl"
                    uen:Region.Attached="True"
                    PaneDisplayMode="Auto"
                    IsBackButtonVisible="Collapsed"
                    IsPaneToggleButtonVisible="True"
                    PaneTitle="Material Design"
                    OpenPaneLength="280"
                    IsSettingsVisible="False"
                    AutomationProperties.AutomationId="MainNavigationView">

      <NavigationView.MenuItems>

        <!-- Home -->
        <NavigationViewItem Content="Home"
                            uen:Region.Name="Home"
                            AutomationProperties.AutomationId="NavItem_Home">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE80F;" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>

        <NavigationViewItemSeparator />
        <NavigationViewItemHeader Content="Input" />

        <NavigationViewItem Content="Buttons"
                            uen:Region.Name="Buttons"
                            AutomationProperties.AutomationId="NavItem_Buttons">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE815;" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>

        <NavigationViewItem Content="Toggles"
                            uen:Region.Name="Toggles"
                            AutomationProperties.AutomationId="NavItem_Toggles">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE8AB;" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>

        <NavigationViewItem Content="Fields"
                            uen:Region.Name="Fields"
                            AutomationProperties.AutomationId="NavItem_Fields">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE70F;" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>

        <NavigationViewItem Content="ComboBoxes"
                            uen:Region.Name="ComboBoxes"
                            AutomationProperties.AutomationId="NavItem_ComboBoxes">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE8FD;" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>

        <NavigationViewItem Content="Pickers"
                            uen:Region.Name="Pickers"
                            AutomationProperties.AutomationId="NavItem_Pickers">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE787;" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>

        <NavigationViewItem Content="Sliders"
                            uen:Region.Name="Sliders"
                            AutomationProperties.AutomationId="NavItem_Sliders">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE9E9;" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>

        <NavigationViewItem Content="Chips"
                            uen:Region.Name="Chips"
                            AutomationProperties.AutomationId="NavItem_Chips">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE8EC;" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>

        <NavigationViewItemSeparator />
        <NavigationViewItemHeader Content="Display" />

        <NavigationViewItem Content="Cards"
                            uen:Region.Name="Cards"
                            AutomationProperties.AutomationId="NavItem_Cards">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE8F1;" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>

        <NavigationViewItem Content="Typography"
                            uen:Region.Name="Typography"
                            AutomationProperties.AutomationId="NavItem_Typography">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE8D2;" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>

        <NavigationViewItem Content="Progress"
                            uen:Region.Name="Progress"
                            AutomationProperties.AutomationId="NavItem_Progress">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xF16A;" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>

        <NavigationViewItem Content="Elevation"
                            uen:Region.Name="Elevation"
                            AutomationProperties.AutomationId="NavItem_Elevation">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE81E;" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>

        <NavigationViewItem Content="Lists"
                            uen:Region.Name="Lists"
                            AutomationProperties.AutomationId="NavItem_Lists">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE8FD;" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>

        <NavigationViewItem Content="Trees"
                            uen:Region.Name="Trees"
                            AutomationProperties.AutomationId="NavItem_Trees">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE8D5;" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>

        <NavigationViewItemSeparator />
        <NavigationViewItemHeader Content="Feedback" />

        <NavigationViewItem Content="Dialogs"
                            uen:Region.Name="Dialogs"
                            AutomationProperties.AutomationId="NavItem_Dialogs">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE8BD;" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>

        <NavigationViewItem Content="Snackbar"
                            uen:Region.Name="Snackbar"
                            AutomationProperties.AutomationId="NavItem_Snackbar">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE8BD;" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>

        <NavigationViewItem Content="ToolTips"
                            uen:Region.Name="ToolTips"
                            AutomationProperties.AutomationId="NavItem_ToolTips">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE82F;" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>

        <NavigationViewItemSeparator />
        <NavigationViewItemHeader Content="Layout" />

        <NavigationViewItem Content="Expander"
                            uen:Region.Name="Expander"
                            AutomationProperties.AutomationId="NavItem_Expander">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE8A0;" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>

        <NavigationViewItem Content="Menus"
                            uen:Region.Name="Menus"
                            AutomationProperties.AutomationId="NavItem_Menus">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE700;" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>

        <NavigationViewItem Content="Drawers"
                            uen:Region.Name="Drawers"
                            AutomationProperties.AutomationId="NavItem_Drawers">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE89F;" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>

      </NavigationView.MenuItems>

      <!-- Content area: required for region-based navigation to render pages -->
      <Grid uen:Region.Attached="True"
            uen:Region.Navigator="Visibility" />

    </NavigationView>
  </Grid>
</Page>
