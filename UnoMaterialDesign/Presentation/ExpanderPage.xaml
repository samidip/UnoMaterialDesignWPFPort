<Page x:Class="UnoMaterialDesign.Presentation.ExpanderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:ut="using:Uno.Themes"
      Background="{ThemeResource SurfaceBrush}">

  <ScrollViewer>
    <StackPanel Padding="32" Spacing="32" MaxWidth="960"
                HorizontalAlignment="Stretch">

      <!-- Page Header -->
      <TextBlock x:Uid="ExpanderPage.Title"
                 Text="Expander"
                 Style="{StaticResource HeadlineLarge}" />
      <TextBlock x:Uid="ExpanderPage.Subtitle"
                 Text="Expander controls allow users to show and hide sections of related content on a page."
                 Style="{StaticResource BodyLarge}"
                 Foreground="{ThemeResource OnSurfaceVariantBrush}" />

      <!-- ═══════ Section 1: Basic Expanders ═══════ -->
      <TextBlock Text="Basic Expanders"
                 Style="{StaticResource TitleLarge}" />

      <Border Background="{ThemeResource SurfaceVariantBrush}"
              CornerRadius="16" Padding="24"
              Translation="0,0,16">
        <Border.Shadow>
          <ThemeShadow />
        </Border.Shadow>

        <StackPanel Spacing="8">
          <TextBlock Text="Standard expand-down behavior with text content."
                     Style="{StaticResource BodyMedium}"
                     Foreground="{ThemeResource OnSurfaceVariantBrush}" />

          <Expander HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Header="Expander Example 1a">
            <StackPanel Padding="16" Spacing="8">
              <TextBlock Text="Your Content" Style="{StaticResource TitleSmall}" />
              <TextBlock Text="Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua."
                         Style="{StaticResource BodySmall}"
                         Foreground="{ThemeResource OnSurfaceVariantBrush}"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Expander>

          <Expander HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Header="Expander Example 1b"
                    ExpandDirection="Up">
            <StackPanel Padding="16" Spacing="8">
              <TextBlock Text="Your Content" Style="{StaticResource TitleSmall}" />
              <TextBlock Text="Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat."
                         Style="{StaticResource BodySmall}"
                         Foreground="{ThemeResource OnSurfaceVariantBrush}"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Expander>

          <Expander HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Header="Expander Example 1c"
                    IsExpanded="True">
            <StackPanel Padding="16" Spacing="8">
              <TextBlock Text="Initially Expanded" Style="{StaticResource TitleSmall}" />
              <TextBlock Text="Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident."
                         Style="{StaticResource BodySmall}"
                         Foreground="{ThemeResource OnSurfaceVariantBrush}"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Expander>
        </StackPanel>
      </Border>

      <!-- ═══════ Section 2: Expanders in a Card ═══════ -->
      <TextBlock Text="Expanders in a Card"
                 Style="{StaticResource TitleLarge}" />

      <utu:Card Style="{StaticResource ElevatedCardStyle}">
        <StackPanel>
          <Expander HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Header="Account Settings">
            <StackPanel Padding="16" Spacing="8">
              <TextBlock Text="Manage your account preferences, display name, and email address."
                         Style="{StaticResource BodySmall}"
                         Foreground="{ThemeResource OnSurfaceVariantBrush}"
                         TextWrapping="Wrap" />
              <Button Content="Edit Profile"
                      Style="{StaticResource TextButtonStyle}" />
            </StackPanel>
          </Expander>

          <Border Height="1" Background="{ThemeResource OutlineBrush}" />

          <Expander HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Header="Privacy &amp; Security">
            <StackPanel Padding="16" Spacing="8">
              <TextBlock Text="Control your privacy settings, two-factor authentication, and data sharing preferences."
                         Style="{StaticResource BodySmall}"
                         Foreground="{ThemeResource OnSurfaceVariantBrush}"
                         TextWrapping="Wrap" />
              <StackPanel Spacing="8">
                <ToggleSwitch Header="Two-factor authentication"
                              AutomationProperties.Name="Two-factor auth toggle" />
                <ToggleSwitch Header="Share usage data"
                              AutomationProperties.Name="Data sharing toggle" />
              </StackPanel>
            </StackPanel>
          </Expander>

          <Border Height="1" Background="{ThemeResource OutlineBrush}" />

          <Expander HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Header="Notifications">
            <StackPanel Padding="16" Spacing="8">
              <TextBlock Text="Choose what notifications you receive and how they are delivered."
                         Style="{StaticResource BodySmall}"
                         Foreground="{ThemeResource OnSurfaceVariantBrush}"
                         TextWrapping="Wrap" />
              <StackPanel Spacing="8">
                <CheckBox Content="Email notifications"
                          IsChecked="True"
                          AutomationProperties.Name="Email notifications" />
                <CheckBox Content="Push notifications"
                          AutomationProperties.Name="Push notifications" />
                <CheckBox Content="SMS alerts"
                          AutomationProperties.Name="SMS alerts" />
              </StackPanel>
            </StackPanel>
          </Expander>
        </StackPanel>
      </utu:Card>

      <!-- ═══════ Section 3: Rich Content Expanders ═══════ -->
      <TextBlock Text="Rich Content"
                 Style="{StaticResource TitleLarge}" />

      <Border Background="{ThemeResource SurfaceVariantBrush}"
              CornerRadius="16" Padding="24"
              Translation="0,0,16">
        <Border.Shadow>
          <ThemeShadow />
        </Border.Shadow>

        <StackPanel Spacing="8">
          <TextBlock Text="Expanders can contain any XAML content including controls, images, and nested layouts."
                     Style="{StaticResource BodyMedium}"
                     Foreground="{ThemeResource OnSurfaceVariantBrush}" />

          <!-- Expander with controls -->
          <Expander HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Header="Input Form">
            <StackPanel Padding="16" Spacing="12">
              <TextBox Header="Name"
                       PlaceholderText="Enter your name"
                       Style="{StaticResource FilledTextBoxStyle}"
                       AutomationProperties.Name="Name field" />
              <TextBox Header="Email"
                       PlaceholderText="Enter your email"
                       Style="{StaticResource FilledTextBoxStyle}"
                       AutomationProperties.Name="Email field" />
              <Button Content="Submit"
                      Style="{StaticResource FilledButtonStyle}"
                      HorizontalAlignment="Right"
                      AutomationProperties.Name="Submit form" />
            </StackPanel>
          </Expander>

          <!-- Expander with list -->
          <Expander HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Header="Recent Activity">
            <StackPanel Padding="16" Spacing="8">
              <Grid ColumnSpacing="12" Padding="0,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Grid.Column="0" Glyph="&#xE8FB;" FontSize="16"
                          Foreground="{ThemeResource PrimaryBrush}" />
                <TextBlock Grid.Column="1" Text="Updated project settings"
                           Style="{StaticResource BodySmall}" />
                <TextBlock Grid.Column="2" Text="2 min ago"
                           Style="{StaticResource LabelSmall}"
                           Foreground="{ThemeResource OnSurfaceVariantBrush}" />
              </Grid>

              <Grid ColumnSpacing="12" Padding="0,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Grid.Column="0" Glyph="&#xE74E;" FontSize="16"
                          Foreground="{ThemeResource TertiaryBrush}" />
                <TextBlock Grid.Column="1" Text="Saved document draft"
                           Style="{StaticResource BodySmall}" />
                <TextBlock Grid.Column="2" Text="15 min ago"
                           Style="{StaticResource LabelSmall}"
                           Foreground="{ThemeResource OnSurfaceVariantBrush}" />
              </Grid>

              <Grid ColumnSpacing="12" Padding="0,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Grid.Column="0" Glyph="&#xE77B;" FontSize="16"
                          Foreground="{ThemeResource SecondaryBrush}" />
                <TextBlock Grid.Column="1" Text="Invited 3 team members"
                           Style="{StaticResource BodySmall}" />
                <TextBlock Grid.Column="2" Text="1 hr ago"
                           Style="{StaticResource LabelSmall}"
                           Foreground="{ThemeResource OnSurfaceVariantBrush}" />
              </Grid>
            </StackPanel>
          </Expander>

          <!-- Expander with progress -->
          <Expander HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Header="Download Progress">
            <StackPanel Padding="16" Spacing="12">
              <StackPanel Spacing="4">
                <TextBlock Text="project-files.zip"
                           Style="{StaticResource BodyMedium}" />
                <ProgressBar Value="72" />
                <TextBlock Text="72% — 4.2 MB of 5.8 MB"
                           Style="{StaticResource LabelSmall}"
                           Foreground="{ThemeResource OnSurfaceVariantBrush}" />
              </StackPanel>

              <StackPanel Spacing="4">
                <TextBlock Text="design-assets.zip"
                           Style="{StaticResource BodyMedium}" />
                <ProgressBar IsIndeterminate="True" />
                <TextBlock Text="Preparing download..."
                           Style="{StaticResource LabelSmall}"
                           Foreground="{ThemeResource OnSurfaceVariantBrush}" />
              </StackPanel>
            </StackPanel>
          </Expander>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</Page>
