<Page x:Class="UnoMaterialDesign.Presentation.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:ut="using:Uno.Themes"
      Background="{ThemeResource SurfaceBrush}">

  <Grid>
    <!-- Main scrollable content -->
    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel>

        <!-- ==================== HERO BANNER ==================== -->
        <Border Background="{ThemeResource PrimaryBrush}"
                Padding="48,64,48,48">
          <Grid HorizontalAlignment="Center"
                MaxWidth="960"
                ColumnSpacing="24">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- XAML Logo placeholder -->
            <Border Width="100"
                    Height="100"
                    CornerRadius="12"
                    VerticalAlignment="Center">
              <FontIcon Glyph="&#x1F4DA;"
                        FontSize="64"
                        Foreground="{ThemeResource OnPrimaryBrush}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
            </Border>

            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center"
                        Spacing="12">
              <TextBlock x:Uid="HomePage_Title"
                         Text="Welcome to Material Design In XAML Toolkit"
                         Style="{StaticResource HeadlineLarge}"
                         Foreground="{ThemeResource OnPrimaryBrush}"
                         TextWrapping="Wrap" />

              <StackPanel Orientation="Horizontal"
                          Spacing="8"
                          HorizontalAlignment="Center">
                <FontIcon Glyph="&#xE80F;"
                          FontSize="14"
                          Foreground="{ThemeResource OnPrimaryBrush}" />
                <TextBlock Text="EXPLORE"
                           Style="{StaticResource LabelLarge}"
                           Foreground="{ThemeResource OnPrimaryBrush}" />
              </StackPanel>
            </StackPanel>
          </Grid>
        </Border>

        <!-- Spacer to push cards down, matching WPF layout -->
        <Border Height="200" />

        <!-- ==================== CARDS SECTION ==================== -->
        <Grid MaxWidth="960"
              HorizontalAlignment="Center"
              ColumnSpacing="24"
              Margin="32,0,32,48">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <!-- Card 1: Get In Touch -->
          <Border Background="{ThemeResource SurfaceBrush}"
                  CornerRadius="16"
                  Translation="0,0,16">
            <Border.Shadow>
              <ThemeShadow />
            </Border.Shadow>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <!-- Left: Full-height artistic image -->
              <Border CornerRadius="16,0,0,16">
                <Border.Background>
                  <ImageBrush Stretch="UniformToFill"
                              ImageSource="https://picsum.photos/id/1025/300/500" />
                </Border.Background>
              </Border>

              <!-- Right: Content -->
              <StackPanel Grid.Column="1"
                          Spacing="12"
                          Margin="20,20,20,16">
                <TextBlock x:Uid="HomePage_GetInTouch_Title"
                           Text="Get In Touch"
                           Style="{StaticResource TitleLarge}" />

                <TextBlock x:Uid="HomePage_GetInTouch_Desc"
                           Text="Say hello, make a feature request, or raise a bug through one of these channels:"
                           Style="{StaticResource BodyMedium}"
                           Foreground="{ThemeResource OnSurfaceVariantBrush}"
                           TextWrapping="Wrap" />

                <!-- 2x2 button grid matching WPF layout -->
                <Grid ColumnSpacing="4"
                      RowSpacing="4"
                      Margin="0,8,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>

                  <Button Style="{StaticResource TextButtonStyle}"
                          Command="{Binding OpenGitHubCommand}"
                          AutomationProperties.Name="GitHub">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <FontIcon Glyph="&#xE12B;" FontSize="16" />
                      <TextBlock Text="GitHub" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>

                  <Button Grid.Column="1"
                          Style="{StaticResource TextButtonStyle}"
                          Command="{Binding OpenTwitterCommand}"
                          AutomationProperties.Name="Twitter">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <FontIcon Glyph="&#xE134;" FontSize="16" />
                      <TextBlock Text="Twitter" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>

                  <Button Grid.Row="1"
                          Style="{StaticResource TextButtonStyle}"
                          Command="{Binding OpenChatCommand}"
                          AutomationProperties.Name="Chat">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <FontIcon Glyph="&#xE8BD;" FontSize="16" />
                      <TextBlock Text="Chat" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>

                  <Button Grid.Row="1"
                          Grid.Column="1"
                          Style="{StaticResource TextButtonStyle}"
                          Command="{Binding OpenEmailCommand}"
                          AutomationProperties.Name="Email">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <FontIcon Glyph="&#xE715;" FontSize="16" />
                      <TextBlock Text="Email" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </Grid>
              </StackPanel>
            </Grid>
          </Border>

          <!-- Card 2: Open Source -->
          <Border Grid.Column="1"
                  Background="{ThemeResource SurfaceBrush}"
                  CornerRadius="16"
                  Translation="0,0,16">
            <Border.Shadow>
              <ThemeShadow />
            </Border.Shadow>
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <!-- Left: GitHub Octocat placeholder -->
              <Border Background="{ThemeResource PrimaryContainerBrush}"
                      CornerRadius="16,0,0,0">
                <FontIcon Glyph="&#x1F419;"
                          FontSize="72"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
              </Border>

              <!-- Right: Title + Description -->
              <StackPanel Grid.Column="1"
                          Spacing="8"
                          Margin="20">
                <TextBlock x:Uid="HomePage_OpenSource_Title"
                           Text="Open Source"
                           Style="{StaticResource TitleLarge}" />

                <TextBlock x:Uid="HomePage_OpenSource_Desc"
                           Text="This project is completely open source. If you like it and want to say thanks you could hit the GitHub Star button, tweet or post about it, or tell your mum about it!"
                           Style="{StaticResource BodyMedium}"
                           Foreground="{ThemeResource OnSurfaceVariantBrush}"
                           TextWrapping="Wrap" />
              </StackPanel>

              <!-- Bottom: Donate row -->
              <Border Grid.Row="1"
                      Grid.ColumnSpan="2"
                      Background="{ThemeResource SurfaceVariantBrush}"
                      CornerRadius="0,0,16,16"
                      Padding="16,12">
                <Grid>
                  <TextBlock VerticalAlignment="Center"
                             Text="Feel like you want to make a donation? It would be gratefully received. Click the button to donate via Open Collective."
                             Style="{StaticResource BodyMedium}"
                             Foreground="{ThemeResource OnSurfaceVariantBrush}"
                             TextWrapping="Wrap"
                             Margin="0,0,100,0" />

                  <Button HorizontalAlignment="Right"
                          VerticalAlignment="Center"
                          Style="{StaticResource TextButtonStyle}"
                          AutomationProperties.Name="Donate"
                          Command="{Binding OpenDonateCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <FontIcon Glyph="&#xE8A1;" FontSize="16" />
                      <TextBlock Text="Donate" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </Grid>
              </Border>
            </Grid>
          </Border>
        </Grid>

      </StackPanel>
    </ScrollViewer>

    <!-- ==================== RIGHT-EDGE FAB STACK ==================== -->
    <StackPanel HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Spacing="8"
                Margin="0,0,16,24">

      <!-- GitHub -->
      <Button Style="{StaticResource SmallFabStyle}"
              Command="{Binding OpenGitHubCommand}"
              Visibility="{Binding AreFabsExpanded}"
              AutomationProperties.Name="GitHub FAB">
        <ut:ControlExtensions.Icon>
          <FontIcon Glyph="&#xE12B;" />
        </ut:ControlExtensions.Icon>
      </Button>

      <!-- Twitter -->
      <Button Style="{StaticResource SmallFabStyle}"
              Command="{Binding OpenTwitterCommand}"
              Visibility="{Binding AreFabsExpanded}"
              AutomationProperties.Name="Twitter FAB">
        <ut:ControlExtensions.Icon>
          <FontIcon Glyph="&#xE134;" />
        </ut:ControlExtensions.Icon>
      </Button>

      <!-- Chat -->
      <Button Style="{StaticResource SmallFabStyle}"
              Command="{Binding OpenChatCommand}"
              Visibility="{Binding AreFabsExpanded}"
              AutomationProperties.Name="Chat FAB">
        <ut:ControlExtensions.Icon>
          <FontIcon Glyph="&#xE8BD;" />
        </ut:ControlExtensions.Icon>
      </Button>

      <!-- Email -->
      <Button Style="{StaticResource SmallFabStyle}"
              Command="{Binding OpenEmailCommand}"
              Visibility="{Binding AreFabsExpanded}"
              AutomationProperties.Name="Email FAB">
        <ut:ControlExtensions.Icon>
          <FontIcon Glyph="&#xE715;" />
        </ut:ControlExtensions.Icon>
      </Button>

      <!-- Donate -->
      <Button Style="{StaticResource TertiaryFabStyle}"
              Command="{Binding OpenDonateCommand}"
              Visibility="{Binding AreFabsExpanded}"
              AutomationProperties.Name="Donate FAB">
        <ut:ControlExtensions.Icon>
          <FontIcon Glyph="&#xE8A1;" />
        </ut:ControlExtensions.Icon>
      </Button>

      <!-- Toggle FABs: X when expanded, chevron-up when collapsed -->
      <Button Style="{StaticResource SecondaryFabStyle}"
              Command="{Binding ToggleFabsCommand}"
              Visibility="{Binding AreFabsExpanded}"
              AutomationProperties.Name="Collapse social buttons">
        <ut:ControlExtensions.Icon>
          <FontIcon Glyph="&#xE711;" />
        </ut:ControlExtensions.Icon>
      </Button>
      <Button Style="{StaticResource SecondaryFabStyle}"
              Command="{Binding ToggleFabsCommand}"
              Visibility="{Binding AreFabsCollapsed}"
              AutomationProperties.Name="Expand social buttons">
        <ut:ControlExtensions.Icon>
          <FontIcon Glyph="&#xE70E;" />
        </ut:ControlExtensions.Icon>
      </Button>

    </StackPanel>
  </Grid>
</Page>
