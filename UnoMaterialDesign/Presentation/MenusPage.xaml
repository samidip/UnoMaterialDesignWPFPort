<Page x:Class="UnoMaterialDesign.Presentation.MenusPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:ut="using:Uno.Themes"
      Background="{ThemeResource SurfaceBrush}">

  <ScrollViewer>
    <StackPanel Padding="32" Spacing="32" MaxWidth="960"
                HorizontalAlignment="Stretch">

      <!-- Page Header -->
      <TextBlock x:Uid="MenusPage.Title"
                 Text="Menus &amp; Toolbars"
                 Style="{StaticResource HeadlineLarge}" />
      <TextBlock x:Uid="MenusPage.Subtitle"
                 Text="MenuBar, MenuFlyout, CommandBar, and context menus for navigation and actions."
                 Style="{StaticResource BodyLarge}"
                 Foreground="{ThemeResource OnSurfaceVariantBrush}" />

      <!-- ═══════ Section 1: MenuBar ═══════ -->
      <TextBlock Text="MenuBar"
                 Style="{StaticResource TitleLarge}" />

      <Border Background="{ThemeResource SurfaceVariantBrush}"
              CornerRadius="16" Padding="24"
              Translation="0,0,16">
        <Border.Shadow>
          <ThemeShadow />
        </Border.Shadow>

        <StackPanel Spacing="16">
          <TextBlock Text="WinUI MenuBar replaces WPF's Menu control with flyout-based submenus."
                     Style="{StaticResource BodyMedium}"
                     Foreground="{ThemeResource OnSurfaceVariantBrush}" />

          <MenuBar>
            <MenuBarItem Title="File">
              <MenuFlyoutItem Text="New">
                <MenuFlyoutItem.Icon>
                  <FontIcon Glyph="&#xE7C3;" />
                </MenuFlyoutItem.Icon>
              </MenuFlyoutItem>
              <MenuFlyoutItem Text="Open">
                <MenuFlyoutItem.Icon>
                  <FontIcon Glyph="&#xE8E5;" />
                </MenuFlyoutItem.Icon>
              </MenuFlyoutItem>
              <MenuFlyoutItem Text="Save">
                <MenuFlyoutItem.Icon>
                  <FontIcon Glyph="&#xE74E;" />
                </MenuFlyoutItem.Icon>
                <MenuFlyoutItem.KeyboardAccelerators>
                  <KeyboardAccelerator Modifiers="Control" Key="S" />
                </MenuFlyoutItem.KeyboardAccelerators>
              </MenuFlyoutItem>
              <MenuFlyoutItem Text="Save As..." />
              <MenuFlyoutSeparator />
              <MenuFlyoutItem Text="Exit">
                <MenuFlyoutItem.Icon>
                  <FontIcon Glyph="&#xE7E8;" />
                </MenuFlyoutItem.Icon>
                <MenuFlyoutItem.KeyboardAccelerators>
                  <KeyboardAccelerator Modifiers="Control" Key="Q" />
                </MenuFlyoutItem.KeyboardAccelerators>
              </MenuFlyoutItem>
            </MenuBarItem>

            <MenuBarItem Title="Edit">
              <MenuFlyoutItem Text="Cut">
                <MenuFlyoutItem.Icon>
                  <FontIcon Glyph="&#xE8C6;" />
                </MenuFlyoutItem.Icon>
                <MenuFlyoutItem.KeyboardAccelerators>
                  <KeyboardAccelerator Modifiers="Control" Key="X" />
                </MenuFlyoutItem.KeyboardAccelerators>
              </MenuFlyoutItem>
              <MenuFlyoutItem Text="Copy">
                <MenuFlyoutItem.Icon>
                  <FontIcon Glyph="&#xE8C8;" />
                </MenuFlyoutItem.Icon>
                <MenuFlyoutItem.KeyboardAccelerators>
                  <KeyboardAccelerator Modifiers="Control" Key="C" />
                </MenuFlyoutItem.KeyboardAccelerators>
              </MenuFlyoutItem>
              <MenuFlyoutItem Text="Paste">
                <MenuFlyoutItem.Icon>
                  <FontIcon Glyph="&#xE77F;" />
                </MenuFlyoutItem.Icon>
                <MenuFlyoutItem.KeyboardAccelerators>
                  <KeyboardAccelerator Modifiers="Control" Key="V" />
                </MenuFlyoutItem.KeyboardAccelerators>
              </MenuFlyoutItem>
              <MenuFlyoutSeparator />
              <ToggleMenuFlyoutItem Text="Word Wrap" />
            </MenuBarItem>

            <MenuBarItem Title="View">
              <ToggleMenuFlyoutItem Text="Status Bar" IsChecked="True" />
              <ToggleMenuFlyoutItem Text="Line Numbers" />
              <MenuFlyoutSeparator />
              <MenuFlyoutSubItem Text="Zoom">
                <MenuFlyoutItem Text="Zoom In" />
                <MenuFlyoutItem Text="Zoom Out" />
                <MenuFlyoutItem Text="Reset Zoom" />
              </MenuFlyoutSubItem>
            </MenuBarItem>

            <MenuBarItem Title="Help">
              <MenuFlyoutItem Text="About" />
              <MenuFlyoutItem Text="Documentation" />
            </MenuBarItem>
          </MenuBar>
        </StackPanel>
      </Border>

      <!-- ═══════ Section 2: CommandBar (Toolbar) ═══════ -->
      <TextBlock Text="CommandBar (Toolbar)"
                 Style="{StaticResource TitleLarge}" />

      <Border Background="{ThemeResource SurfaceVariantBrush}"
              CornerRadius="16" Padding="24"
              Translation="0,0,16">
        <Border.Shadow>
          <ThemeShadow />
        </Border.Shadow>

        <StackPanel Spacing="16">
          <TextBlock Text="WinUI CommandBar replaces WPF's ToolBar with AppBarButtons and overflow."
                     Style="{StaticResource BodyMedium}"
                     Foreground="{ThemeResource OnSurfaceVariantBrush}" />

          <CommandBar DefaultLabelPosition="Right"
                      HorizontalAlignment="Stretch">
            <AppBarButton Icon="Save" Label="Save" />
            <AppBarButton Icon="Edit" Label="Edit" />
            <AppBarButton Icon="Delete" Label="Delete" />
            <AppBarSeparator />
            <AppBarButton Icon="Cut" Label="Cut" />
            <AppBarButton Icon="Copy" Label="Copy" />
            <AppBarButton Icon="Paste" Label="Paste" />
            <AppBarSeparator />
            <AppBarButton Icon="Undo" Label="Undo" />
            <AppBarButton Icon="Redo" Label="Redo" />

            <CommandBar.SecondaryCommands>
              <AppBarButton Icon="Setting" Label="Settings" />
              <AppBarButton Label="Help" />
              <AppBarSeparator />
              <AppBarButton Label="About" />
            </CommandBar.SecondaryCommands>
          </CommandBar>

          <Border Height="1" Background="{ThemeResource OutlineBrush}" Margin="0,4" />

          <TextBlock Text="Icon-only compact toolbar"
                     Style="{StaticResource LabelLarge}" />

          <CommandBar DefaultLabelPosition="Collapsed"
                      HorizontalAlignment="Left">
            <AppBarButton Icon="Bold" ToolTipService.ToolTip="Bold" />
            <AppBarButton Icon="Italic" ToolTipService.ToolTip="Italic" />
            <AppBarButton Icon="Underline" ToolTipService.ToolTip="Underline" />
            <AppBarSeparator />
            <AppBarButton ToolTipService.ToolTip="Align Left">
              <AppBarButton.Icon>
                <FontIcon Glyph="&#xE8E4;" />
              </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton ToolTipService.ToolTip="Align Center">
              <AppBarButton.Icon>
                <FontIcon Glyph="&#xE8E3;" />
              </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton ToolTipService.ToolTip="Align Right">
              <AppBarButton.Icon>
                <FontIcon Glyph="&#xE8E2;" />
              </AppBarButton.Icon>
            </AppBarButton>
          </CommandBar>
        </StackPanel>
      </Border>

      <!-- ═══════ Section 3: Context Menus ═══════ -->
      <TextBlock Text="Context Menus"
                 Style="{StaticResource TitleLarge}" />

      <Border Background="{ThemeResource SurfaceVariantBrush}"
              CornerRadius="16" Padding="24"
              Translation="0,0,16">
        <Border.Shadow>
          <ThemeShadow />
        </Border.Shadow>

        <StackPanel Spacing="16">
          <TextBlock Text="Right-click (or long-press on touch) to open context menus on these controls."
                     Style="{StaticResource BodyMedium}"
                     Foreground="{ThemeResource OnSurfaceVariantBrush}" />

          <Grid ColumnSpacing="24">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Default context menu on TextBox -->
            <StackPanel Grid.Column="0" Spacing="8">
              <TextBlock Text="Default context menu" Style="{StaticResource LabelLarge}" />
              <TextBox Text="Select and right-click"
                       Style="{StaticResource FilledTextBoxStyle}"
                       AutomationProperties.Name="TextBox with default context menu" />
            </StackPanel>

            <!-- Custom context menu -->
            <StackPanel Grid.Column="1" Spacing="8">
              <TextBlock Text="Custom context menu" Style="{StaticResource LabelLarge}" />
              <TextBox Text="Right-click for custom menu"
                       Style="{StaticResource FilledTextBoxStyle}"
                       AutomationProperties.Name="TextBox with custom context menu">
                <TextBox.ContextFlyout>
                  <MenuFlyout>
                    <MenuFlyoutItem Text="Hello World">
                      <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE76E;" />
                      </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Clickety Click">
                      <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE8B0;" />
                      </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutSubItem Text="More Options">
                      <MenuFlyoutItem Text="Option A" />
                      <MenuFlyoutItem Text="Option B" />
                      <MenuFlyoutItem Text="Option C" />
                    </MenuFlyoutSubItem>
                  </MenuFlyout>
                </TextBox.ContextFlyout>
              </TextBox>
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>

      <!-- ═══════ Section 4: MenuFlyout on Button ═══════ -->
      <TextBlock Text="MenuFlyout on Buttons"
                 Style="{StaticResource TitleLarge}" />

      <Border Background="{ThemeResource SurfaceVariantBrush}"
              CornerRadius="16" Padding="24"
              Translation="0,0,16">
        <Border.Shadow>
          <ThemeShadow />
        </Border.Shadow>

        <StackPanel Spacing="16">
          <TextBlock Text="Attach a MenuFlyout to a button for dropdown-style menus."
                     Style="{StaticResource BodyMedium}"
                     Foreground="{ThemeResource OnSurfaceVariantBrush}" />

          <StackPanel Orientation="Horizontal" Spacing="12">
            <DropDownButton Content="Sort By"
                            Style="{StaticResource FilledTonalButtonStyle}"
                            AutomationProperties.Name="Sort menu">
              <DropDownButton.Flyout>
                <MenuFlyout>
                  <MenuFlyoutItem Text="Name" />
                  <MenuFlyoutItem Text="Date Modified" />
                  <MenuFlyoutItem Text="Size" />
                  <MenuFlyoutSeparator />
                  <ToggleMenuFlyoutItem Text="Ascending" IsChecked="True" />
                </MenuFlyout>
              </DropDownButton.Flyout>
            </DropDownButton>

            <DropDownButton Content="Actions"
                            Style="{StaticResource OutlinedButtonStyle}"
                            AutomationProperties.Name="Actions menu">
              <DropDownButton.Flyout>
                <MenuFlyout>
                  <MenuFlyoutItem Text="Rename">
                    <MenuFlyoutItem.Icon>
                      <FontIcon Glyph="&#xE8AC;" />
                    </MenuFlyoutItem.Icon>
                  </MenuFlyoutItem>
                  <MenuFlyoutItem Text="Move to...">
                    <MenuFlyoutItem.Icon>
                      <FontIcon Glyph="&#xE8DE;" />
                    </MenuFlyoutItem.Icon>
                  </MenuFlyoutItem>
                  <MenuFlyoutItem Text="Delete">
                    <MenuFlyoutItem.Icon>
                      <FontIcon Glyph="&#xE74D;" />
                    </MenuFlyoutItem.Icon>
                  </MenuFlyoutItem>
                </MenuFlyout>
              </DropDownButton.Flyout>
            </DropDownButton>

            <SplitButton Content="Reply"
                         AutomationProperties.Name="Reply split button">
              <SplitButton.Flyout>
                <MenuFlyout>
                  <MenuFlyoutItem Text="Reply All" />
                  <MenuFlyoutItem Text="Forward" />
                  <MenuFlyoutSeparator />
                  <MenuFlyoutItem Text="Reply with Template" />
                </MenuFlyout>
              </SplitButton.Flyout>
            </SplitButton>
          </StackPanel>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</Page>
