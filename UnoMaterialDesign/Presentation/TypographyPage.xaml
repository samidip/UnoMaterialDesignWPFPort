<Page x:Class="UnoMaterialDesign.Presentation.TypographyPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:utu="using:Uno.Toolkit.UI"
      Background="{ThemeResource SurfaceBrush}">

  <Page.Resources>
    <!-- Pill badge style for metadata columns -->
    <Style x:Key="BadgeBorder" TargetType="Border">
      <Setter Property="BorderBrush" Value="{ThemeResource OutlineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Page.Resources>

  <ScrollViewer>
    <StackPanel Padding="32" Spacing="32" MaxWidth="1100"
                HorizontalAlignment="Stretch">

      <!-- Page Header -->
      <TextBlock x:Uid="TypographyPage.Title"
                 Text="Typography"
                 Style="{StaticResource HeadlineLarge}" />
      <TextBlock x:Uid="TypographyPage.Subtitle"
                 Text="Material Design 3 type scale — 15 styles across 5 roles."
                 Style="{StaticResource BodyLarge}"
                 Foreground="{ThemeResource OnSurfaceVariantBrush}" />

      <!-- Type Scale Table -->
      <Border Background="{ThemeResource SurfaceVariantBrush}"
              CornerRadius="16"
              Padding="24"
              Translation="0,0,16">
        <Border.Shadow>
          <ThemeShadow />
        </Border.Shadow>

        <Grid RowSpacing="4" ColumnSpacing="16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto" />
            <!-- Separator -->
            <RowDefinition Height="Auto" />
            <!-- Display group -->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <!-- Headline group -->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <!-- Title group -->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <!-- Label group -->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <!-- Body group -->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- Header Row -->
          <TextBlock Grid.Row="0" Grid.Column="0" Text="Weight"
                     Style="{StaticResource LabelLarge}"
                     Foreground="{ThemeResource OnSurfaceVariantBrush}"
                     VerticalAlignment="Center" />
          <TextBlock Grid.Row="0" Grid.Column="1" Text="Size"
                     Style="{StaticResource LabelLarge}"
                     Foreground="{ThemeResource OnSurfaceVariantBrush}"
                     VerticalAlignment="Center" />
          <TextBlock Grid.Row="0" Grid.Column="2" Text="Height"
                     Style="{StaticResource LabelLarge}"
                     Foreground="{ThemeResource OnSurfaceVariantBrush}"
                     VerticalAlignment="Center" />
          <TextBlock Grid.Row="0" Grid.Column="3" Text="Preview"
                     Style="{StaticResource LabelLarge}"
                     Foreground="{ThemeResource OnSurfaceVariantBrush}"
                     VerticalAlignment="Center" />

          <!-- Separator -->
          <Border Grid.Row="1" Grid.ColumnSpan="4"
                  Height="1" Margin="0,8"
                  Background="{ThemeResource OutlineBrush}" />

          <!-- ═══ Display ═══ -->
          <!-- DisplayLarge  Regular  57  64 -->
          <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource BadgeBorder}">
            <TextBlock Text="Regular" Style="{StaticResource LabelSmall}" />
          </Border>
          <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource BadgeBorder}">
            <TextBlock Text="57" Style="{StaticResource LabelSmall}" />
          </Border>
          <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource BadgeBorder}">
            <TextBlock Text="64" Style="{StaticResource LabelSmall}" />
          </Border>
          <TextBlock Grid.Row="2" Grid.Column="3"
                     Text="Display Large"
                     Style="{StaticResource DisplayLarge}"
                     VerticalAlignment="Center"
                     Padding="0,12" />

          <!-- DisplayMedium  Regular  45  52 -->
          <Border Grid.Row="3" Grid.Column="0" Style="{StaticResource BadgeBorder}">
            <TextBlock Text="Regular" Style="{StaticResource LabelSmall}" />
          </Border>
          <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource BadgeBorder}">
            <TextBlock Text="45" Style="{StaticResource LabelSmall}" />
          </Border>
          <Border Grid.Row="3" Grid.Column="2" Style="{StaticResource BadgeBorder}">
            <TextBlock Text="52" Style="{StaticResource LabelSmall}" />
          </Border>
          <TextBlock Grid.Row="3" Grid.Column="3"
                     Text="Display Medium"
                     Style="{StaticResource DisplayMedium}"
                     VerticalAlignment="Center"
                     Padding="0,12" />

          <!-- DisplaySmall  Regular  36  44 -->
          <Border Grid.Row="4" Grid.Column="0" Style="{StaticResource BadgeBorder}">
            <TextBlock Text="Regular" Style="{StaticResource LabelSmall}" />
          </Border>
          <Border Grid.Row="4" Grid.Column="1" Style="{StaticResource BadgeBorder}">
            <TextBlock Text="36" Style="{StaticResource LabelSmall}" />
          </Border>
          <Border Grid.Row="4" Grid.Column="2" Style="{StaticResource BadgeBorder}">
            <TextBlock Text="44" Style="{StaticResource LabelSmall}" />
          </Border>
          <TextBlock Grid.Row="4" Grid.Column="3"
                     Text="Display Small"
                     Style="{StaticResource DisplaySmall}"
                     VerticalAlignment="Center"
                     Padding="0,12" />

          <!-- ═══ Headline ═══ -->
          <!-- HeadlineLarge  Regular  32  40 -->
          <Border Grid.Row="5" Grid.Column="0" Style="{StaticResource BadgeBorder}">
            <TextBlock Text="Regular" Style="{StaticResource LabelSmall}" />
          </Border>
          <Border Grid.Row="5" Grid.Column="1" Style="{StaticResource BadgeBorder}">
            <TextBlock Text="32" Style="{StaticResource LabelSmall}" />
          </Border>
          <Border Grid.Row="5" Grid.Column="2" Style="{StaticResource BadgeBorder}">
            <TextBlock Text="40" Style="{StaticResource LabelSmall}" />
          </Border>
          <TextBlock Grid.Row="5" Grid.Column="3"
                     Text="Headline Large"
                     Style="{StaticResource HeadlineLarge}"
                     VerticalAlignment="Center"
                     Padding="0,12" />

          <!-- HeadlineMedium  Regular  28  36 -->
          <Border Grid.Row="6" Grid.Column="0" Style="{StaticResource BadgeBorder}">
            <TextBlock Text="Regular" Style="{StaticResource LabelSmall}" />
          </Border>
          <Border Grid.Row="6" Grid.Column="1" Style="{StaticResource BadgeBorder}">
            <TextBlock Text="28" Style="{StaticResource LabelSmall}" />
          </Border>
          <Border Grid.Row="6" Grid.Column="2" Style="{StaticResource BadgeBorder}">
            <TextBlock Text="36" Style="{StaticResource LabelSmall}" />
          </Border>
          <TextBlock Grid.Row="6" Grid.Column="3"
                     Text="Headline Medium"
                     Style="{StaticResource HeadlineMedium}"
                     VerticalAlignment="Center"
                     Padding="0,12" />

          <!-- HeadlineSmall  Regular  24  32 -->
          <Border Grid.Row="7" Grid.Column="0" Style="{StaticResource BadgeBorder}">
            <TextBlock Text="Regular" Style="{StaticResource LabelSmall}" />
          </Border>
          <Border Grid.Row="7" Grid.Column="1" Style="{StaticResource BadgeBorder}">
            <TextBlock Text="24" Style="{StaticResource LabelSmall}" />
          </Border>
          <Border Grid.Row="7" Grid.Column="2" Style="{StaticResource BadgeBorder}">
            <TextBlock Text="32" Style="{StaticResource LabelSmall}" />
          </Border>
          <TextBlock Grid.Row="7" Grid.Column="3"
                     Text="Headline Small"
                     Style="{StaticResource HeadlineSmall}"
                     VerticalAlignment="Center"
                     Padding="0,12" />

          <!-- ═══ Title ═══ -->
          <!-- TitleLarge  Medium  22  28 -->
          <Border Grid.Row="8" Grid.Column="0" Style="{StaticResource BadgeBorder}">
            <TextBlock Text="Medium" Style="{StaticResource LabelSmall}" />
          </Border>
          <Border Grid.Row="8" Grid.Column="1" Style="{StaticResource BadgeBorder}">
            <TextBlock Text="22" Style="{StaticResource LabelSmall}" />
          </Border>
          <Border Grid.Row="8" Grid.Column="2" Style="{StaticResource BadgeBorder}">
            <TextBlock Text="28" Style="{StaticResource LabelSmall}" />
          </Border>
          <TextBlock Grid.Row="8" Grid.Column="3"
                     Text="Title Large"
                     Style="{StaticResource TitleLarge}"
                     VerticalAlignment="Center"
                     Padding="0,12" />

          <!-- TitleMedium  Medium  16  24 -->
          <Border Grid.Row="9" Grid.Column="0" Style="{StaticResource BadgeBorder}">
            <TextBlock Text="Medium" Style="{StaticResource LabelSmall}" />
          </Border>
          <Border Grid.Row="9" Grid.Column="1" Style="{StaticResource BadgeBorder}">
            <TextBlock Text="16" Style="{StaticResource LabelSmall}" />
          </Border>
          <Border Grid.Row="9" Grid.Column="2" Style="{StaticResource BadgeBorder}">
            <TextBlock Text="24" Style="{StaticResource LabelSmall}" />
          </Border>
          <TextBlock Grid.Row="9" Grid.Column="3"
                     Text="Title Medium"
                     Style="{StaticResource TitleMedium}"
                     VerticalAlignment="Center"
                     Padding="0,12" />

          <!-- TitleSmall  Medium  14  20 -->
          <Border Grid.Row="10" Grid.Column="0" Style="{StaticResource BadgeBorder}">
            <TextBlock Text="Medium" Style="{StaticResource LabelSmall}" />
          </Border>
          <Border Grid.Row="10" Grid.Column="1" Style="{StaticResource BadgeBorder}">
            <TextBlock Text="14" Style="{StaticResource LabelSmall}" />
          </Border>
          <Border Grid.Row="10" Grid.Column="2" Style="{StaticResource BadgeBorder}">
            <TextBlock Text="20" Style="{StaticResource LabelSmall}" />
          </Border>
          <TextBlock Grid.Row="10" Grid.Column="3"
                     Text="Title Small"
                     Style="{StaticResource TitleSmall}"
                     VerticalAlignment="Center"
                     Padding="0,12" />

          <!-- ═══ Label ═══ -->
          <!-- LabelLarge  Medium  14  20 -->
          <Border Grid.Row="11" Grid.Column="0" Style="{StaticResource BadgeBorder}">
            <TextBlock Text="Medium" Style="{StaticResource LabelSmall}" />
          </Border>
          <Border Grid.Row="11" Grid.Column="1" Style="{StaticResource BadgeBorder}">
            <TextBlock Text="14" Style="{StaticResource LabelSmall}" />
          </Border>
          <Border Grid.Row="11" Grid.Column="2" Style="{StaticResource BadgeBorder}">
            <TextBlock Text="20" Style="{StaticResource LabelSmall}" />
          </Border>
          <TextBlock Grid.Row="11" Grid.Column="3"
                     Text="Label Large"
                     Style="{StaticResource LabelLarge}"
                     VerticalAlignment="Center"
                     Padding="0,12" />

          <!-- LabelMedium  Medium  12  16 -->
          <Border Grid.Row="12" Grid.Column="0" Style="{StaticResource BadgeBorder}">
            <TextBlock Text="Medium" Style="{StaticResource LabelSmall}" />
          </Border>
          <Border Grid.Row="12" Grid.Column="1" Style="{StaticResource BadgeBorder}">
            <TextBlock Text="12" Style="{StaticResource LabelSmall}" />
          </Border>
          <Border Grid.Row="12" Grid.Column="2" Style="{StaticResource BadgeBorder}">
            <TextBlock Text="16" Style="{StaticResource LabelSmall}" />
          </Border>
          <TextBlock Grid.Row="12" Grid.Column="3"
                     Text="Label Medium"
                     Style="{StaticResource LabelMedium}"
                     VerticalAlignment="Center"
                     Padding="0,12" />

          <!-- LabelSmall  Medium  11  16 -->
          <Border Grid.Row="13" Grid.Column="0" Style="{StaticResource BadgeBorder}">
            <TextBlock Text="Medium" Style="{StaticResource LabelSmall}" />
          </Border>
          <Border Grid.Row="13" Grid.Column="1" Style="{StaticResource BadgeBorder}">
            <TextBlock Text="11" Style="{StaticResource LabelSmall}" />
          </Border>
          <Border Grid.Row="13" Grid.Column="2" Style="{StaticResource BadgeBorder}">
            <TextBlock Text="16" Style="{StaticResource LabelSmall}" />
          </Border>
          <TextBlock Grid.Row="13" Grid.Column="3"
                     Text="Label Small"
                     Style="{StaticResource LabelSmall}"
                     VerticalAlignment="Center"
                     Padding="0,12" />

          <!-- ═══ Body ═══ -->
          <!-- BodyLarge  Regular  16  24 -->
          <Border Grid.Row="14" Grid.Column="0" Style="{StaticResource BadgeBorder}">
            <TextBlock Text="Regular" Style="{StaticResource LabelSmall}" />
          </Border>
          <Border Grid.Row="14" Grid.Column="1" Style="{StaticResource BadgeBorder}">
            <TextBlock Text="16" Style="{StaticResource LabelSmall}" />
          </Border>
          <Border Grid.Row="14" Grid.Column="2" Style="{StaticResource BadgeBorder}">
            <TextBlock Text="24" Style="{StaticResource LabelSmall}" />
          </Border>
          <TextBlock Grid.Row="14" Grid.Column="3"
                     Text="Body Large"
                     Style="{StaticResource BodyLarge}"
                     VerticalAlignment="Center"
                     Padding="0,12" />

          <!-- BodyMedium  Regular  14  20 -->
          <Border Grid.Row="15" Grid.Column="0" Style="{StaticResource BadgeBorder}">
            <TextBlock Text="Regular" Style="{StaticResource LabelSmall}" />
          </Border>
          <Border Grid.Row="15" Grid.Column="1" Style="{StaticResource BadgeBorder}">
            <TextBlock Text="14" Style="{StaticResource LabelSmall}" />
          </Border>
          <Border Grid.Row="15" Grid.Column="2" Style="{StaticResource BadgeBorder}">
            <TextBlock Text="20" Style="{StaticResource LabelSmall}" />
          </Border>
          <TextBlock Grid.Row="15" Grid.Column="3"
                     Text="Body Medium"
                     Style="{StaticResource BodyMedium}"
                     VerticalAlignment="Center"
                     Padding="0,12" />

          <!-- BodySmall  Regular  12  16 -->
          <Border Grid.Row="16" Grid.Column="0" Style="{StaticResource BadgeBorder}">
            <TextBlock Text="Regular" Style="{StaticResource LabelSmall}" />
          </Border>
          <Border Grid.Row="16" Grid.Column="1" Style="{StaticResource BadgeBorder}">
            <TextBlock Text="12" Style="{StaticResource LabelSmall}" />
          </Border>
          <Border Grid.Row="16" Grid.Column="2" Style="{StaticResource BadgeBorder}">
            <TextBlock Text="16" Style="{StaticResource LabelSmall}" />
          </Border>
          <TextBlock Grid.Row="16" Grid.Column="3"
                     Text="Body Small"
                     Style="{StaticResource BodySmall}"
                     VerticalAlignment="Center"
                     Padding="0,12" />
        </Grid>
      </Border>

    </StackPanel>
  </ScrollViewer>
</Page>
