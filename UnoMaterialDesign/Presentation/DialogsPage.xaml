<Page x:Class="UnoMaterialDesign.Presentation.DialogsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:ut="using:Uno.Themes"
      Background="{ThemeResource SurfaceBrush}">

  <ScrollViewer>
    <StackPanel Padding="32" Spacing="32" MaxWidth="960"
                HorizontalAlignment="Stretch">

      <!-- Page Header -->
      <TextBlock x:Uid="DialogsPage.Title"
                 Text="Dialogs"
                 Style="{StaticResource HeadlineLarge}" />
      <TextBlock x:Uid="DialogsPage.Subtitle"
                 Text="ContentDialog is the standard way to show modal dialogs in WinUI / Uno. Dialogs can contain any content and return a result."
                 Style="{StaticResource BodyLarge}"
                 Foreground="{ThemeResource OnSurfaceVariantBrush}" />

      <!-- ═══════ Section 1: Basic Dialogs ═══════ -->
      <TextBlock Text="Basic Dialogs"
                 Style="{StaticResource TitleLarge}" />

      <Border Background="{ThemeResource SurfaceVariantBrush}"
              CornerRadius="16" Padding="24"
              Translation="0,0,16">
        <Border.Shadow>
          <ThemeShadow />
        </Border.Shadow>

        <StackPanel Spacing="16">
          <TextBlock Text="Simple informational and confirmation dialogs launched from code-behind."
                     Style="{StaticResource BodyMedium}"
                     Foreground="{ThemeResource OnSurfaceVariantBrush}" />

          <StackPanel Orientation="Horizontal" Spacing="12">
            <Button Content="Basic Dialog"
                    Click="ShowBasicDialog_Click"
                    Style="{StaticResource FilledButtonStyle}"
                    AutomationProperties.Name="Show basic dialog">
              <ut:ControlExtensions.Icon>
                <FontIcon Glyph="&#xE8BD;" FontSize="16" />
              </ut:ControlExtensions.Icon>
            </Button>

            <Button Content="Confirm Dialog"
                    Click="ShowConfirmDialog_Click"
                    Style="{StaticResource FilledTonalButtonStyle}"
                    AutomationProperties.Name="Show confirm dialog">
              <ut:ControlExtensions.Icon>
                <FontIcon Glyph="&#xE8C1;" FontSize="16" />
              </ut:ControlExtensions.Icon>
            </Button>

            <Button Content="Custom Content"
                    Click="ShowCustomContentDialog_Click"
                    Style="{StaticResource OutlinedButtonStyle}"
                    AutomationProperties.Name="Show custom content dialog">
              <ut:ControlExtensions.Icon>
                <FontIcon Glyph="&#xE70B;" FontSize="16" />
              </ut:ControlExtensions.Icon>
            </Button>
          </StackPanel>

          <Border Height="1" Background="{ThemeResource OutlineBrush}" Margin="0,4" />

          <!-- Result display -->
          <StackPanel Spacing="4">
            <TextBlock Text="Last dialog result:" Style="{StaticResource LabelLarge}" />
            <TextBlock Text="{Binding DialogResult}"
                       Style="{StaticResource BodyMedium}"
                       Foreground="{ThemeResource PrimaryBrush}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- ═══════ Section 2: Fruit Bowl (Add via Dialog) ═══════ -->
      <TextBlock Text="Fruit Bowl"
                 Style="{StaticResource TitleLarge}" />

      <Border Background="{ThemeResource SurfaceVariantBrush}"
              CornerRadius="16" Padding="24"
              Translation="0,0,16">
        <Border.Shadow>
          <ThemeShadow />
        </Border.Shadow>

        <Grid RowSpacing="16">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0"
                     Text="Add items to the list by opening a dialog with a text field."
                     Style="{StaticResource BodyMedium}"
                     Foreground="{ThemeResource OnSurfaceVariantBrush}" />

          <ListView Grid.Row="1"
                    ItemsSource="{Binding Fruits}"
                    MaxHeight="200"
                    AutomationProperties.Name="Fruit list" />

          <Grid Grid.Row="2">
            <Border Background="{ThemeResource PrimaryContainerBrush}"
                    CornerRadius="12" Padding="16">
              <Grid>
                <TextBlock Text="🍎 Fruit Bowl"
                           Style="{StaticResource TitleSmall}"
                           VerticalAlignment="Center" />
                <Button HorizontalAlignment="Right"
                        Click="ShowAddFruitDialog_Click"
                        Style="{StaticResource SmallFabStyle}"
                        AutomationProperties.Name="Add fruit">
                  <ut:ControlExtensions.Icon>
                    <FontIcon Glyph="&#xE710;" FontSize="16" />
                  </ut:ControlExtensions.Icon>
                </Button>
              </Grid>
            </Border>
          </Grid>
        </Grid>
      </Border>

      <!-- ═══════ Section 3: Petting Zoo (Add via Dialog) ═══════ -->
      <TextBlock Text="Petting Zoo"
                 Style="{StaticResource TitleLarge}" />

      <Border Background="{ThemeResource SurfaceVariantBrush}"
              CornerRadius="16" Padding="24"
              Translation="0,0,16">
        <Border.Shadow>
          <ThemeShadow />
        </Border.Shadow>

        <Grid RowSpacing="16">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0"
                     Text="Another list managed through a dialog — this mirrors WPF Sample 5 (embedded dialog)."
                     Style="{StaticResource BodyMedium}"
                     Foreground="{ThemeResource OnSurfaceVariantBrush}" />

          <ListView Grid.Row="1"
                    ItemsSource="{Binding Animals}"
                    MaxHeight="200"
                    AutomationProperties.Name="Animal list" />

          <Grid Grid.Row="2">
            <Border Background="{ThemeResource SecondaryContainerBrush}"
                    CornerRadius="12" Padding="16">
              <Grid>
                <TextBlock Text="🐾 Petting Zoo"
                           Style="{StaticResource TitleSmall}"
                           VerticalAlignment="Center" />
                <Button HorizontalAlignment="Right"
                        Click="ShowAddAnimalDialog_Click"
                        Style="{StaticResource SmallFabStyle}"
                        AutomationProperties.Name="Add animal">
                  <ut:ControlExtensions.Icon>
                    <FontIcon Glyph="&#xE710;" FontSize="16" />
                  </ut:ControlExtensions.Icon>
                </Button>
              </Grid>
            </Border>
          </Grid>
        </Grid>
      </Border>

      <!-- ═══════ Section 4: Dialog Types Reference ═══════ -->
      <TextBlock Text="Dialog Types Reference"
                 Style="{StaticResource TitleLarge}" />

      <Border Background="{ThemeResource SurfaceVariantBrush}"
              CornerRadius="16" Padding="24"
              Translation="0,0,16">
        <Border.Shadow>
          <ThemeShadow />
        </Border.Shadow>

        <StackPanel Spacing="16">
          <TextBlock Text="ContentDialog supports up to three buttons and any XAML content."
                     Style="{StaticResource BodyMedium}"
                     Foreground="{ThemeResource OnSurfaceVariantBrush}" />

          <Grid ColumnSpacing="16" RowSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Info card -->
            <Border Grid.Column="0"
                    Background="{ThemeResource SurfaceBrush}"
                    CornerRadius="12" Padding="16"
                    Translation="0,0,4">
              <Border.Shadow>
                <ThemeShadow />
              </Border.Shadow>
              <StackPanel Spacing="8">
                <FontIcon Glyph="&#xE946;" FontSize="28"
                          Foreground="{ThemeResource PrimaryBrush}"
                          HorizontalAlignment="Left" />
                <TextBlock Text="Informational"
                           Style="{StaticResource TitleSmall}" />
                <TextBlock Text="Single close button. Use for alerts and notifications."
                           Style="{StaticResource BodySmall}"
                           Foreground="{ThemeResource OnSurfaceVariantBrush}"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <!-- Confirm card -->
            <Border Grid.Column="1"
                    Background="{ThemeResource SurfaceBrush}"
                    CornerRadius="12" Padding="16"
                    Translation="0,0,4">
              <Border.Shadow>
                <ThemeShadow />
              </Border.Shadow>
              <StackPanel Spacing="8">
                <FontIcon Glyph="&#xE8C1;" FontSize="28"
                          Foreground="{ThemeResource TertiaryBrush}"
                          HorizontalAlignment="Left" />
                <TextBlock Text="Confirmation"
                           Style="{StaticResource TitleSmall}" />
                <TextBlock Text="Primary + Secondary buttons. Use for destructive or important actions."
                           Style="{StaticResource BodySmall}"
                           Foreground="{ThemeResource OnSurfaceVariantBrush}"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <!-- Input card -->
            <Border Grid.Column="2"
                    Background="{ThemeResource SurfaceBrush}"
                    CornerRadius="12" Padding="16"
                    Translation="0,0,4">
              <Border.Shadow>
                <ThemeShadow />
              </Border.Shadow>
              <StackPanel Spacing="8">
                <FontIcon Glyph="&#xE70B;" FontSize="28"
                          Foreground="{ThemeResource SecondaryBrush}"
                          HorizontalAlignment="Left" />
                <TextBlock Text="Input / Custom"
                           Style="{StaticResource TitleSmall}" />
                <TextBlock Text="Any XAML content including text fields, progress bars, or custom layouts."
                           Style="{StaticResource BodySmall}"
                           Foreground="{ThemeResource OnSurfaceVariantBrush}"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </Grid>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</Page>
